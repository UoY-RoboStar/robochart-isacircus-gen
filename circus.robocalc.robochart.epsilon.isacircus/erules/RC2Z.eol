//Rule 19
operation createControllerAsProcessPara(c: RC!ControllerDef): Z!ProcessPara{

	//declare channels for controller c, this is not covered RoboChart manual
	c.createchanParaCtrl();
	
	
	//declare Constants, this is not covered RoboChart manual
	declareConstants(c);
	
	var actionParaSeq = new Sequence<Z!ActionPara>;
	
	//to create operation sematics for defined ops
	for(op in c.lOperations){
		if(op.nodes.isDefined()){
//			actionParaSeq.add(createOperationDefAsActionPara(op));
			createOperationDefAsActionPara(op);
		}
	}
	
	//to create operation sematics for required ops
	var requiredOperations = new Set<RC!OperationSig>;
	for(ri in c.rInterfaces){
		for(op in ri.operations){
			requiredOperations.add(op);
		}
	}
	
	//eg.,
	//CALL__move1(id__,
//						    param_m,
//						    param_m1) 	= move1Call.param_m.param_m1 -> SKIP
//	createCallOpActionPara(op) = move1Call.param_m.param_m1 -> SKIP
	
	for(op in requiredOperations){
//		actionParaSeq.add(createCallOpActionPara(op));
		createCallOpActionPara(op);
	}
	
	
	
	/* Rule 19, rewritten 25 Nov 2026 (CONTROLLER_PLAN 7.10, decisions of Fang 1-7 of 25 Nov 2026).
	   - the machines: every instance (inline StateMachineDef or StateMachineRef) is translated once (Rule 25) with the
	     names of the instance (enterInstance), then renamed at the composition (Rule 22, renamingMachinePara);
	   - synchronisation set: the controller's local variables set_v, the machines' copies set_EXT_v_<m> written by
	     the memory (as the CSP-M, CControllerGenerator compileAux; the manual's Rule 19 omits them, SEMANTICS_DIFFERENCES
	     22) and terminate (option 2: no exception, the memory offers terminate -> Skip; SEMANTICS_DIFFERENCES 26);
	   - hidden: set_v of the local variables and the copies, as the CSP-M; NOT the set_EXT_v of the controller's own
	     required variables (the manual hides them as rvars; the CSP-M does not; SEMANTICS_DIFFERENCES 24);
	   - constants: consts at both levels, no set_ events and no memory parameters (decision 7; SEMANTICS_DIFFERENCES 21);
	     before, lconsts/rconsts (set_c of constants) were in both sets and the constants were memory parameters. */
	var cons = c.connections;
	var insts = c.machines.select(m|(m.isKindOf(RC!StateMachineDef) or m.isKindOf(RC!StateMachineRef)) and not m.isKindOf(RC!OperationDef)).asSequence();

	//Rule 25 per instance, then Rule 22
	var copyChans = createChannelPara("machine_copy_channels_ctrl_" + c.FQN());
	var connChans = createChannelPara("internal_connection_channels_ctrl_" + c.FQN());
	for(i in insts){
		enterInstance(i);
		var stmPara = createStateMachineDefAsActionPara(instDef(i));
		leaveInstance(i);
		renamingMachinePara(c, i, cons, stmPara.name.word);
		for(v in copiedVariables(c, i)){
			copyChans.declList.decls.add(Sequence{copyChan(v, i)}.createChannelDecl(v.type.createTypeExpr()));
		}
		for(con in cons.select(x|x.from = i and x.to.isKindOf(RC!StateMachine))){
			var evt_seq = Sequence{qualifiedEventChan(con.efrom, i) + "_in", qualifiedEventChan(con.efrom, i) + "_out"};
			if(con.efrom.type = null){
				connChans.declList.decls.add(evt_seq.createChannelDecl());
			} else {
				connChans.declList.decls.add(evt_seq.createChannelDecl(con.efrom.type.createTypeExpr()));
			}
		}
	}

	//Rule 21
	var composeMachinePara = composeMachinesAction(c, insts, cons).createActionPara("composeMachines_" + c.FQN());

	//Rule 20
	var memoryPara = ctrlMemoryPara(c, insts);
	var vars = memoryVariables(c);
	var memoryCall;
	if(vars.size() > 0){
		var initialSeq = new Sequence<Z!Expr>;
		for(v in vars){
			initialSeq.add(v.getInitialOrDefaultValueAsExpr());
			//in the manual: initial only, but it should be 'initial or default' (Rule 20)
		}
		memoryCall = memoryPara.name.word.createCallAction(initialSeq);
	} else {
		memoryCall = memoryPara.name.word.createCallAction();
	}

	var lvars = new Sequence<String>;
	for(v in allLocalVariables(c)){
		lvars.add("set_" + v.name);
	}
	var copies = new Sequence<String>;
	for(i in insts){
		for(v in copiedVariables(c, i)){
			copies.add(copyChan(v, i));
		}
	}

	var cs = new Set<String>;
	cs.addAll(lvars);
	cs.addAll(copies);
	cs.add("terminate");

	var action = createParallelAction(cs, composeMachinePara.name.word.createCallAction(), memoryCall);

	var hide_cs = lvars.includingAll(copies);
	if(hide_cs.size() > 0){
		action = action.createHideAction(hide_cs);
	}

	//create main action
	var mainPara = action.createActionPara("controller_action_" + c.FQN());
	operationsNote(c, mainPara);

	//add every actionpara including the main action para into the sequence
	for(action_para in Z!ActionPara.all()){
		actionParaSeq.add(action_para);
	}

	var mainActionname = "controller_action_" + c.FQN();

	var basicProcess = actionParaSeq.createBasicProcess(mainActionname);

	//is this a basic process? although actionParaSeq contains two actionparas
	return basicProcess.createProcessPara("controller_proc_" + c.FQN(), true);
	//true means it is a BasicProcss
	
}


/* Channels need to be declared for the following:
1.Vars channel:
- vars declared directly in the controller
- vars declared in the defined interfaces
2. Shared variable channels: set_EXT_
3. Declaring controller events as channels: 
- all the events that are declared in the defined interfaces, and 
- All events declared in the controller
4. Declaring call events for undefined operations as channels
*/
//channel decleration and channelset declaration for Controller
operation RC!Controller createchanParaCtrl()  {
	

	//CASE 1. variable channels, each var has a channel declaration, as vars can have different types, while the channels in the chandecl.list should have the same type.
	
	
	var var_chanpara = createChannelPara("var_channels_ctrl_" + self.FQN());
	
	//Case 1.1: variable channels for vars declared directly in the controller
	for(vl in self.variableList){
		if(vl.modifier = RC!VariableModifier#VAR){
//			var i=0;
			for(v in vl.vars){
				
				var type_expr = v.type.createTypeExpr();
				
				var var_seq = Sequence{"get_" + v.name , 
									   "set_" + v.name };
									   
				var_chanpara.declList.decls.add(var_seq.createChannelDecl(type_expr));
				
			}
		}
	}
	
	//Case 1.2: variable channels for vars declared in the defined interfaces
	for(defined_interface in self.interfaces){
		for(vl in defined_interface.variableList){
			if(vl.modifier = RC!VariableModifier#VAR){
				for(v in vl.vars){
					
					var type_expr = v.type.createTypeExpr();
					
					var var_seq = Sequence{"get_" + v.name , 
										   "set_" + v.name };
										   
					var_chanpara.declList.decls.add(var_seq.createChannelDecl(type_expr));
					
				}
			}
		}
	}
	
	//CASE 2. Shared variable channels: set_EXT_
	if(self.hasSharedVars()){//i.e., has requied interface which contains variables
		var shared_var_chanpara = createChannelPara("shared_var_channel_ctrl_" + self.FQN());
		for(ri in self.rInterfaces){
			for(vl in ri.variableList.select(l|l.modifier = VariableModifier#VAR)){
				for(v in vl.vars){
					
					var type_expr = v.type.createTypeExpr();
					
					var var_seq = Sequence{"set_EXT_" + v.name};
					//TBC with Pedro: v to be FQN at which level? stm or ctrl or pkg?
					
					shared_var_chanpara.declList.decls.add(var_seq.createChannelDecl(type_expr));
				}
			}
		}
	}
	

	//CASE 3. Declaring controller events as channels

	var evt_chanpara = createChannelPara("event_channel_ctrl_" + self.FQN());
	
	//to create the type for the controller event channels (external), 
	//e.g., CSPM: channel turn: InOut.Chemical_Angle
	
	//3.1 to collect all the events declared in the controller
	var ctrl_events = self.events;
	
	//3.2 to collect all the events that are defined in the defined interfaces
	for(defined_interface in self.interfaces){
		ctrl_events = ctrl_events.includingAll(defined_interface.events);
	}
	
	for(e in ctrl_events){
				
		var evt_seq = Sequence{e.name + "_in", //CSPM InOut enumtype is removed for Circus, so becomes 2 channels
							   e.name + "_out"};
									   
		if(e.type=null){
			evt_chanpara.declList.decls.add(evt_seq.createChannelDecl());	
		}else{
			var type_expr = e.type.createTypeExpr();
			evt_chanpara.declList.decls.add(evt_seq.createChannelDecl(type_expr));
		}
	}
	

	
	//CASE 4. Declaring call events for undefined operations as channels
	
	if(self.hasRequiredOps()){//TBC with Pedro: is hasRequiredOps enough?
		var undefined_ops_chanpara = createChannelPara("undefined_op_channel_ctrl_" + self.FQN());
		for(ri in self.rInterfaces){
			for(op in ri.operations){
				var op_seq = Sequence{op.name + "Call"};
				var size = op.parameters.size();
				if(size = 0){
	
					undefined_ops_chanpara.declList.decls.add(op_seq.createChannelDecl());	
	
				} else if(size = 1){
										
					var type_expr = op.parameters.at(0).type.createTypeExpr();
					undefined_ops_chanpara.declList.decls.add(op_seq.createChannelDecl(type_expr));
					
				} else if(op.parameters.size()>1){
					
					var prodExpr = createProdExpr(op.parameters.at(0).type.createTypeExpr(), op.parameters.at(1).type.createTypeExpr());
					var i = 2;
					if(size > 2){
						while(i<size){
							prodExpr = createProdExpr(prodExpr,op.parameters.at(i).type.createTypeExpr());
							i++;
						}
					}		
				
					undefined_ops_chanpara.declList.decls.add(op_seq.createChannelDecl(prodExpr));
				}
			}
		}
	}
	
	
	
	
	
	
	//KEEP IT FOR NOW, but not used
	//shared_variable_events
	var shared_var_events_channelset = createChannelSet(createBasicChannelSetExpr(sharedVarSet(self)));
	var shared_variable_events_channelsetPara = shared_var_events_channelset.createChanSetPara("shared_variable_events_ctrl_"+self.FQN());
	
	
	
}

operation Sequence<RC!Variable> getNames(): Sequence<String>{
	var nameSet = new Sequence<String>;
	for(v in self){
		nameSet.add(v.name);		
	}
	return nameSet;
}

operation Set<RC!Variable> getInitialValues(): Set<String>{
	var initSet = new Set<String>;
	for(v in self){
		initSet.add(v.initial.toString());		
	}
	return initSet;
}

/* Rules 20 to 23 for the controller, rewritten 25 Nov 2026 (CONTROLLER_PLAN 7.10, decisions of Fang of 25 Nov 2026).
   Naming (SEMANTICS_DIFFERENCES 20): the machine paragraphs are printed as for the machine alone (variant (ii)); the
   composition renames each machine instance m:
   - an event of m connected to the controller to the controller's event (CSP-M stm::e <- f, manual Rule 22);
   - an event of m that is the TARGET of a connection from machine src to the qualified event of the source,
     e_<FQN src>_in/out with in and out swapped (CSP-M tgt::f.in <- src::e.out, manual Rule 22);
   - an event of m that is the SOURCE of a connection to another machine to e_<FQN m>_in/out (the CSP-M keeps
     src::e; the qualification is the injective correspondence with it in the global name space of the theory);
   - set_EXT_v to set_EXT_v_<FQN m> for each required variable v of m provided by the controller: the write of the
     controller memory into m's copy (CSP-M m::set_EXT_v). The manual's Rule 22 has no such pair (only the constants'
     set_vid(v) <- set_vid(v,c)); added as Rule 22 does for constants (SEMANTICS_DIFFERENCES 22, manual omission, to
     ask Alvaro).
   The events of m that are not connected are hidden in m before the renaming (CSP-M RenamingStateMachineChanset;
   not in the manual; decision 2 of Fang, SEMANTICS_DIFFERENCES 23, to ask Pedro). The pairs set_c <- set_c of
   required constants are gone (constants are consts, decision 7). Instances are compared with the connection ends
   directly: no copy of a referenced definition exists any more (replaceRef, defect 8). */

//the events of a machine definition (its own and those of its defined interfaces, as createchanParaNC)
operation stmEvents(d: RC!StateMachineDef): Sequence{
	var evts = new Sequence;
	evts.addAll(d.events);
	for(defined_interface in d.interfaces){
		for(e in defined_interface.events){
			if(not evts.includes(e)){
				evts.add(e);
			}
		}
	}
	return evts;
}

//the variables of the controller that the instance i requires; matched by NAME, as the CSP-M
//(CControllerGenerator: rvarsNames.contains(v.name)): the controller's variable and the variable of the required
//interface are different objects (decision 4 of Fang, 25 Nov 2026; before, object identity gave no machine)
operation copiedVariables(c: RC!ControllerDef, i: Any): Sequence{
	var names = requiredVariables(instDef(i)).collect(v|v.name);
	return memoryVariables(c).select(v|names.includes(v.name));
}

//the copy of v in the instance i, written by the controller memory (CSP-M i::set_EXT_v)
operation copyChan(v: RC!Variable, i: Any): String{
	return "set_EXT_" + v.name + "_" + instFQN(i);
}

//the channel base of the event e of the instance i, qualified by the instance (source of an internal connection)
operation qualifiedEventChan(e: RC!Event, i: Any): String{
	return e.name + "_" + instFQN(i);
}

//the variables of the controller memory, in the order of the parameters (required, then local, as before)
operation memoryVariables(c: RC!ControllerDef): Sequence{
	return requiredVariables(c).asSequence().includingAll(allLocalVariables(c).asSequence());
}

//Rule 22
operation renamingMachinePara(c: RC!ControllerDef, i: Any, cons: Any, stmName: String): Z!ActionPara{
	var L = new Sequence<String>;
	var R = new Sequence<String>;
	var connected = new Sequence;
	for(con in cons){
		if(con.from = i){
			connected.add(con.efrom);
			if(con.to.isKindOf(RC!Controller)){
				L.add(con.efrom.name + "_in");  R.add(con.eto.name + "_in");
				L.add(con.efrom.name + "_out"); R.add(con.eto.name + "_out");
			} else if(con.to.isKindOf(RC!StateMachine)){
				L.add(con.efrom.name + "_in");  R.add(qualifiedEventChan(con.efrom, i) + "_in");
				L.add(con.efrom.name + "_out"); R.add(qualifiedEventChan(con.efrom, i) + "_out");
			}
		}
		if(con.to = i){
			connected.add(con.eto);
			if(con.from.isKindOf(RC!Controller)){
				L.add(con.eto.name + "_in");  R.add(con.efrom.name + "_in");
				L.add(con.eto.name + "_out"); R.add(con.efrom.name + "_out");
			} else if(con.from.isKindOf(RC!StateMachine)){
				L.add(con.eto.name + "_in");  R.add(qualifiedEventChan(con.efrom, con.from) + "_out");
				L.add(con.eto.name + "_out"); R.add(qualifiedEventChan(con.efrom, con.from) + "_in");
			}
		}
	}
	for(v in copiedVariables(c, i)){
		L.add("set_EXT_" + v.name); R.add(copyChan(v, i));
	}
	var hidden = new Sequence<String>;
	for(e in stmEvents(instDef(i))){
		if(not connected.includes(e)){
			hidden.add(e.name + "_in");
			hidden.add(e.name + "_out");
		}
	}
	var action = stmName.createCallAction();
	if(hidden.size() > 0){
		action = action.createHideAction(hidden);
	}
	if(L.size() > 0){
		action = action.createRenameAction(L, R);
	}
	return action.createActionPara("renamingMachine_" + instFQN(i));
}

//Rule 23: the events of the internal connections between the instance head and the instances of tail
//(as qualified channels of the source) 
operation internalConnChans(head: Any, tail: Sequence, cons: Any): Sequence<String>{
	var chans = new Sequence<String>;
	for(con in cons){
		if(con.from.isKindOf(RC!StateMachine) and con.to.isKindOf(RC!StateMachine) and
		   ((con.from = head and tail.includes(con.to)) or (con.to = head and tail.includes(con.from)))){
			for(suffix in Sequence{"_in", "_out"}){
				var ch = qualifiedEventChan(con.efrom, con.from) + suffix;
				if(not chans.includes(ch)){
					chans.add(ch);
				}
			}
		}
	}
	return chans;
}

//Rule 21: right-nested composition of the renamed machines, synchronised on the internal connections and
//terminate; the internal connection events are hidden afterwards, as the CSP-M (composeStateMachines:
//\ diff(intersection, {|terminate|})); the manual's Rule 21 does not hide them (SEMANTICS_DIFFERENCES 23).
//terminate is in the set (option 2, as before).
operation composeMachinesAction(c: RC!ControllerDef, insts: Sequence, cons: Any): Z!CircusAction{
	var head = insts.at(0);
	var headCall = ("renamingMachine_" + instFQN(head)).createCallAction();
	if(insts.size() = 1){
		return headCall;
	}
	var tail = insts.clone();
	tail.removeAt(0);
	var connevts = internalConnChans(head, tail, cons);
	var sync = new Set<String>;
	sync.addAll(connevts);
	sync.add("terminate");
	var action = createParallelAction(sync, headCall, composeMachinesAction(c, tail, cons));
	if(connevts.size() > 0){
		action = action.createHideAction(connevts);
	}
	return action;
}

//Rule 20: one recursive memory over the variables of the controller (required, then local), as before; a write
//set_v?x (local v) or set_EXT_v?x (required v) is forwarded to the copies of the instances that require v, in the
//order of the machines of the controller (the CSP-M: set_v?x__ -> m1::set_EXT_v!x__ -> m2::set_EXT_v!x__ -> Memory),
//then the memory continues with the new value; terminate -> Skip (option 2). No constants (decision 7). Without
//variables: terminate -> Skip (defect 6). Named ctrlMemory_<c> (decision 5; before the paragraph was crtlMemory_<c>
//and its recursive calls ctrlMemory_<c>, defect 4).
operation ctrlMemoryPara(c: RC!ControllerDef, insts: Sequence): Z!ActionPara{
	var name = "ctrlMemory_" + c.FQN();
	var terminateSkip = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	var vars = memoryVariables(c);
	if(vars.size() = 0){
		return terminateSkip.createActionPara(name);
	}
	var names = vars.collect(v|v.name);
	var branches = new Sequence<Z!CircusAction>;
	for(v in vars){
		var newNames = new Sequence<String>;
		for(n in names){
			if(n = v.name){
				newNames.add("x__v");
			} else {
				newNames.add(n);
			}
		}
		var act = name.createCallAction(newNames.createRefExprSeq(false,false));
		var targets = insts.select(t|copiedVariables(c, t).exists(x|x.name = v.name));
		var k = targets.size() - 1;
		while(k >= 0){
			act = createPrefixingAction(createOutputCommunicationFromString(copyChan(v, targets.at(k)), "x__v", "OUTPUT"), act);
			k = k - 1;
		}
		var input;
		if(allLocalVariables(c).includes(v)){
			input = createInputCommunication("set_" + v.name, "x__v");
		} else {
			input = createInputCommunication("set_EXT_" + v.name, "x__v");
		}
		branches.add(createPrefixingAction(input, act));
	}
	branches.add(terminateSkip);
	var body = branches.createSequenceAsExtchoiceAction();
	var action = new Z!ParamAction;
	action.isParamCommand = true;
	action.circusAction = body;
	action.declList = new Z!ZDeclList;
	for(v in vars){
		action.declList.decls.add(createVarDecl(v));
	}
	return action.createActionPara(name);
}

//Decision 8 of Fang (25 Nov 2026): operations of a controller (Rule 27, generator issue R) are not translated yet; an
//explicit warning instead of a silent undefined call CALL__<op>
operation operationsNote(c: RC!ControllerDef, para: Z!ActionPara){
	if(c.lOperations.size() > 0){
		var note = "The operations of controller " + c.name + " (" + c.lOperations.collect(o|o.name).concat(", ")
			+ ") are not supported yet (Chapter 4 Rule 27, generator issue R): a call of them in a state machine is printed as CALL__<operation>, which is not defined, so the theory does not load.";
		if(para.generatorNote.isDefined() and para.generatorNote <> ""){
			para.generatorNote = para.generatorNote + " " + note;
		} else {
			para.generatorNote = note;
		}
	}
}


//Rule 25
operation createStateMachineDefAsActionPara(stm: RC!StateMachineDef): Z!ActionPara{

	//declare Constants, this is not covered in RoboChart manual
	declareConstants(stm);
	
	
	var action = stateful(stm).name.word.createCallAction().createHideAction(Sequence{"terminate"});
	
	action = createAction2("SeqAction", action, createAction2("InterruptAction", "SSTOP".createCallAction(), createPrefixingAction(createSynchCommunication("terminate"), createSkipAction())));
	
	var renamepairL = new Sequence<String>;
	var renamepairR = new Sequence<String>;
	for(v in requiredVariables(stm)){
		 renamepairL.add("share");
		 renamepairR.add("set_EXT_" + v.name);
	}
	//TBC the direction of renaming
	
	action = action.createRenameAction(renamepairL, renamepairR);
	//Synchronisation with Skip on {share} (Rule 25 writes {shared}; Alvaro confirmed on 27 Nov 2026 that this is a
	//typo for share; RoboTool's CSP-M: [| {share__} |] SKIP), whether or not the machine has required variables.
	//With required variables share no longer occurs after the renaming, so nothing is blocked and the machine accepts
	//set_EXT_v wherever it offered share. Without required variables the renaming is empty and share is blocked, so
	//the machine cannot idle on share: a deadlock of the machine is not hidden by an endless offer of share.
	//History: from 9 Oct 2026 (9faa957) to 26 Nov 2026 the set was shared_variable_events_in_stmbd_<stm>
	//(= range set_EXT_v), which blocked every external write (issue PP, fixed in 1.0.0.202611262148 for machines with
	//required variables); for machines without required variables that set is empty, which left share unblocked
	//(fixed here). The set shared_variable_events_in_stmbd_<stm> is still declared but no longer used here.
	action = createParallelAction(Set{"share"}, action, createSkipAction());
	
	var sharedVarSync = new Set<String>;
	for(v in requiredVariables(stm)){
		sharedVarSync.add("get_" + v.name);
		sharedVarSync.add("set_" + v.name);
		sharedVarSync.add("set_EXT_" + v.name);
	}
	
	var sharedVarHide = new Set<String>;
	for(v in requiredVariables(stm)){
		sharedVarHide.add("get_" + v.name);
	}
	
	var sharedConstSync = new Set<String>;
	for(v in requiredVariables(stm)){
		sharedVarHide.add("get_" + v.name);
	}
	
	var cs = sharedVarSync.includingAll(sharedConstSync);
	cs.add("terminate");
	
	action = createParallelAction(cs, action, sharedVarMemory(stm).name.word.createCallAction()).createHideAction(sharedVarHide.includingAll(sharedConstSync).asSequence());
	
	return action.createActionPara("stm_" + stm.FQN());
}

//Rule 26, the return type is different from the manual (Z!ChannelSet)
operation getsetChannels(stm: RC!StateMachineDef): Set<String>{
	var channelSet = new Set<String>;
	for(v in allVariables(s)){
		channelSet.add("get_" + v.name);
		channelSet.add("set_" + v.name);
	}
	for(v in allConstants(s)){
		channelSet.add("get_" + v.name);
		channelSet.add("set_" + v.name);
	}
	return channelSet;
}


//Rule 27
operation createOperationDefAsActionPara(op: RC!OperationDef): Z!ActionPara{
	var statefulpara = stateful(op);
	
//	statefule is an actionpara, the action of this actionpara is assigned to action below
	var action = statefulpara.circusAction.createHideAction(Sequence{"terminate"});
	"lin 797".println(); op.eContainer().println();
	
//	now, stateful only has a name, no action, and it is no more needed, so deleted
	delete statefulpara;
	return action.createActionPara("stm_op_" + op.FQN());
	
}

//Rule 28
//not to be implemented at the moment
//as this is not often used in RoboChart




/* Rule 32, 34, 36, 38 for constants are not implemented because constants are processed as parameters*/
//Rule 29, different from the manual: machineBody is taken out as a standalone operation
operation stateful(stm: RC!StateMachineBody): Z!ActionPara{
	
	var parallelL = machineBody(stm).name.word.createCallAction();
	var parallelR = varMemory(stm).name.word.createCallAction();
	var channelSet = getsetLocalChannels(stm);
	var channelSetAndTerm = getsetLocalChannels(stm);
	channelSetAndTerm.add("terminate");
	//TO DO: terminate is not a channel set, so .add not work here
	//{|set_v, get_v|} unioin {terminate}
	//THIS NEEDS TO BE FIXED
	//15 March 2026
	
	
	var stateful = createParallelAction(channelSetAndTerm, parallelL, parallelR).createHideAction(channelSet.asSequence());
	
	return stateful.createActionPara("stateful_"+ stm.FQN());
}

//Rule 29-2 - MachineBody
operation machineBody(stm: RC!StateMachineBody): Z!ActionPara{
	
	var parallelL = ncBehaviour(stm).name.word.createCallAction();
	var parallelR = createSkipAction();
	var channelSet = Set{"interrupt_" + stm.FQN()};//sync on interrupt means stm can not be interrupted according to Pedro
	//hide the declared channel set enteredSS_in_stmbd_<stm> by name (a RefExpr), not as a single channel "enteredSS_<stm>"
	var machineBody = createParallelAction(channelSet, parallelL,parallelR).createHideAction("enteredSS_in_stmbd_"+stm.FQN());
	
	return machineBody.createActionPara("machineBody_"+ stm.FQN());
}

//Rule 30, the return type is different from the manual (Z!ChannelSet)
operation getsetLocalChannels(s: RC!StateMachineBody): Set<String>{
	var channelSet = new Set<String>;
	for(v in allLocalVariables(s)){
		channelSet.add("get_" + v.name);
		channelSet.add("set_" + v.name);
	}
	return channelSet;
}

//Rule 31
operation varMemory(stm: RC!Context): Z!ActionPara{


	var vars = allLocalVariables(stm);
	
	//to generate Individual variable memory as ActionPara for each variable in vars
	for(v in vars){
//		("line 1581, v = " + v + ", type.type.NAME = " + v.type.type.name  + ", v.type.type()" + v.type.type()).println();
		//,  type.ref.name =  + v.type.ref.name
		Memory(v,stm);
	}
	
	
	var varMemory;
	if(vars.size()=0){
		varMemory = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	} 
	
	else if(vars.size()=1) {
		
		var action_name = "Memory_"+ vars.at(0).name;
		var ParaSeq = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};//Para here means parameter
		varMemory = action_name.createCallAction(ParaSeq);
		//By assigning initial or default value as parameter of this CallAction, 
		//Memory(x) is instantiated.
	} 
	
	else if(vars.size()>1){
		("line 1600, vars = " + vars).println();
		var action_name0 = "Memory_"+ vars.at(0).name;
		var ParaSeq0 = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};	("line 1602, ParaSeq0 = " + ParaSeq0).println();
		var action0 = action_name0.createCallAction(ParaSeq0);
		
		var action_name1 = "Memory_"+ vars.at(1).name;
//		("line 1606, vars.at(1) = " + vars.at(1)).println();
//		("line 1606, vars.at(1).type = " + vars.at(1).type).println();		
//		("line 1606, vars.at(1).type.type() = " + vars.at(1).type.type().name).println();		
//		("line 1606, vars.at(1).type.ref = " + vars.at(1).type.ref).println();
		var ParaSeq1 = Sequence{vars.at(1).getInitialOrDefaultValueAsExpr()};
		("ParaSeq1 = " + ParaSeq1).println();
		var action1 = action_name1.createCallAction(ParaSeq1);
		
		
		varMemory = createParallelAction(
						Set{"terminate"}, 
						action0, 
						action1
					);
		
		vars.removeAt(0);
		vars.removeAt(0);		
		while(vars.size()>0){
			("line 1627, v = " + vars.at(0) + ", type.type.NAME = " + vars.at(0).type.type.name  + ", v.type.type()" + vars.at(0).type.type()).println();
		
			var action_name = "Memory_"+ vars.at(0).name;
			var ParaSeq = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};
			var action = action_name.createCallAction(ParaSeq);
		
			varMemory = createParallelAction(Set{"terminate"}, varMemory, action);			
			vars.removeAt(0);
		}
	}
	
	return varMemory.createActionPara("varMemory_"+ stm.FQN());
}


operation RC!Variable getInitialOrDefaultValueAsExpr(): Z!Expr{

	("line 1643, var = " + self).println();
	if(self.initial != null){
		"self.initial != null".println();
		return self.initial.createExpr();
	} 
	else{
		
		"self.initial = null".println();
		return self.type.defaultValueAsZExpr();			
	}
}



//Rule 33, follows the same pattern as Rule 31
// TO DO: is fully qualified name needed for shared var? what is the FQN for shared var?

operation sharedVarMemory(stm: RC!Context): Z!ActionPara{
	//OPEN QUESTION (25 Nov 2026, SEMANTICS_DIFFERENCES 25): the copy of a required variable starts with the default
	//of its type, not with the initial value of the providing controller's variable; RoboTool's CSP-M does the same
	//(Memory_obs(0); checked with FDR on ctl_init, proof repository controller-fdr/shared-init). Not changed.

	var vars = requiredVariables(stm);
	
	//to generate Individual shared variable memory as ActionPara for each variable in vars
	for(v in vars){
//		("line 1566, v = " + v + ", v.type = " + v.type   +  ", v.type.type = " + v.type.type  + ", type.type.NAME = " + v.type.type.name  + ", v.type.type()= " + v.type.type()).println();
		//,  type.ref.name =  + v.type.ref.name
		sharedMemory(v);
	}
	
	
	var sharedVarMemory;
	if(vars.size()=0){
		sharedVarMemory = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	} 
	
	else if(vars.size()=1) {
		
		var action_name = "sharedMemory_"+ vars.at(0).name;
		var ParaSeq = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};
		sharedVarMemory = action_name.createCallAction(ParaSeq);
		//By assigning initial or default value as parameter of this CallAction, 
		//Memory(x) is instantiated.
	} 
	
	else if(vars.size()>1){
		("line 1600, vars = " + vars).println();
		var action_name0 = "sharedMemory_"+ vars.at(0).name;
		var ParaSeq0 = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};	//("line 1602, ParaSeq0 = " + ParaSeq0).println();
		var action0 = action_name0.createCallAction(ParaSeq0);
		
		var action_name1 = "sharedMemory_"+ vars.at(1).name;
//		("line 1606, vars.at(1) = " + vars.at(1)).println();
//		("line 1606, vars.at(1).type = " + vars.at(1).type).println();		
//		("line 1606, vars.at(1).type.type() = " + vars.at(1).type.type().name).println();		
//		("line 1606, vars.at(1).type.ref = " + vars.at(1).type.ref).println();
		var ParaSeq1 = Sequence{vars.at(1).getInitialOrDefaultValueAsExpr()};
		("ParaSeq1 = " + ParaSeq1).println();
		var action1 = action_name1.createCallAction(ParaSeq1);
		
		
		sharedVarMemory = createParallelAction(
						Set{"terminate"}, 
						action0, 
						action1
					);
		
		vars.removeAt(0);
		vars.removeAt(0);		
		while(vars.size()>0){

			var action_name = "sharedMemory_"+ vars.at(0).name;
			var ParaSeq = Sequence{vars.at(0).getInitialOrDefaultValueAsExpr()};
			var action = action_name.createCallAction(ParaSeq);
		
			sharedVarMemory = createParallelAction(Set{"terminate"}, sharedVarMemory, action);			
			vars.removeAt(0);
		}
	}
	
	return sharedVarMemory.createActionPara("sharedVarMemory_"+ stm.FQN());
}



//Rule 35 
/*this is different from the RoboChart manual in two ways
1. the main body is moved to function IndividualVarMemory
2. the initial or default value of the variable is assigned in Rule according to the manual, but in CSPM code, it is assigned when Memory(v) is called in varMemory; So to be consistent with CSPM, the within part in Rule 35 of manual is moved to Rule 31 here above.

In fact, there is no need to have a ParamAction, because the parameter value is
only assigned as initial or default, that is a one time thing, so it can be done directly in IndividualVarMemory. However, to be consistent with manual, the implementation still uses ParamAction.
*/
operation Memory(v: RC!Variable,stm: RC!Context): Z!ActionPara{

//	v_FQN is the fully qualified name of v: stm variables are already renamed to <name>_<stm FQN>
//	by the FQN pre-processing (FQNllLocalVariables), so the suffix must not be added again here
	var v_FQN = v.name;
	return IndividualVarMemory(v,v_FQN).createActionPara("Memory_" + v_FQN);

}

/*
	so, Memory_a(0) =
					get_a!0 -> Memory_a(0)
					[]
					set_a?x__ -> Memory_a(x__)
					[]
					terminate -> SKIP  ??
Memory_a(0) is an action whose name is Memory_a, parameter is a RC!Expression, 0 in this case
*/

/*e.g., Memory_a(0) where
		Memory_a(value) =
					get_a!value -> Memory_a(value)
					[]
					set_a?x__ -> Memory_a(x__)
					[]
					terminate -> SKIP
here we need ParamAction  */
//Rule 35 auxilary
/*IndividualVarMemory is a function taking variable v as its paramter
 *it returns a ParamAction whose paramter is value of type RC!Expression
 *we do not create AcitonPara in this function because IndividualVarMemory is 
 *recursive, it makes code simple if we create ActionPara at the final step
 *i.e., in Rule 35
 *v_FQN is the fully qualified name of v */
operation IndividualVarMemory(v: RC!Variable, v_FQN: String): Z!ParamAction{
	
	
	//the parameter is value__v (23 Nov 2026, issue NN; before value, captured by a constant value of the model)
	var commu1  = createOutputCommunicationFromString("get_" + v_FQN, "value__v", "OUTPUT");
	var choice1 = createPrefixingAction(
						commu1, 
						("Memory_"+ v_FQN).createCallAction(Sequence{"value__v".createRefExpr(false, false)})
						); 
	
	
	
	var commu2  = createInputCommunication("set_" + v_FQN, "x__v");
	var choice2 = createPrefixingAction(
						commu2, 
						("Memory_"+ v_FQN).createCallAction(Sequence{"x__v".createRefExpr(false, false)})
						);  
	
	var choice3 = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	
	var memory = createAction2("ExtChoiceAction", choice1, createAction2("ExtChoiceAction", choice2, choice3));
	
	var action = new Z!ParamAction;
	action.isParamCommand = true;
	action.circusAction = memory;
	
	var value = new RC!Variable;
	value.name = "value__v";
//	("line 1745,  v.type = " + v.type).println();
//	("line 1746,  v.type.type() = " + v.type.type()).println();
//	("line 1738,  v.type.type = " + v.type.type).println();
//	("line 1739,  v.type.ref = " + v.type.ref).println();
	value.type = clone(v.type);
//	param.type.ref = clone(v.type.ref);
//	("line 1741,  v.type = " + v.type.type.ref).println();
//	("line 1742,  v.type = " + v.type.type.ref).println();
	("line 1750, value.type = " + value.type).println();
//	("line 1750, value.type.ref = " + value.type.ref).println();
	action.declList = new Z!ZDeclList;
	action.declList.decls.add(createVarDecl(value));
	
	return action;
}

//TO DO: this operation should be no longer needed, but I kept it here temporally as more work needed if remove it
/*When converting RoboChart to CSPM, default values are assigned to uninitialized constants as a workaround
due to limitations of FDR. However, this step is not necessary in the RoboChart2Circus process, 
as Isabelle can handle infinite scopes.
*/
operation RC!Type defaultValueAsZExpr(): Z!Expr{
("line 1807, self.type().name = " + self.type().name).println();

	//Fix of generator issue KK (23 Nov 2026, branch composite-states). The default value of a variable without
	//initial value is that of RoboTool's CSP-M (robochart-csp-gen a6412b4, untimed/GeneratorUtils.xtend 285-326,
	//typeDefaultValue; the same in comp/untimed/CGeneratorUtils.xtend 368): int, nat, real 0; boolean true;
	//string ""; an enumeration its first literal, applied to the defaults of the literal's parameters (MM); a
	//record the record of the defaults of its fields, in the order of the declaration (LL); a sequence <>, a
	//set {}, a tuple the tuple of the defaults (below). DIFFERENT FROM THE MANUAL: Rule 35 (memory) leaves the
	//value of a variable without initial value arbitrary (docs/SEMANTICS_DIFFERENCES.md). Before, every type
	//other than int and boolean got 0 (also on main), a type error in Isabelle for enumerations, records and
	//strings. A primitive type declared in the model (type T, declared as type_synonym T = nat) gets 0, as
	//in the CSP-M; a function type A -> B the constant function with the default of B (CSP-M: funcToSet(\ x_ @ d,
	//A)). Types this generator does not support (relation, vector, matrix, and anything else) get the marker
	//GENERATOR_ERROR_default_value_<type> (generatorErrors.eol); the CSP-M gives {} and tuples for them.
	if(self.type().name = "TypeRef"){
		var r = self.ref;
		if(r.isKindOf(RC!Enumeration)){
			var lit = r.literals.first();
			if(lit.types.isDefined() and lit.types.size() > 0){
				var cargs = Sequence{lit.name.createRefExpr(false,false)};
				for(pt in lit.types){
					cargs.add(pt.defaultValueAsZExpr());
				}
				return createOperatorApplExpr("_conapp_", cargs);
			}
			return lit.name.createRefExpr(false,false);
		}
		if(r.isKindOf(RC!RecordType)){
			var rargs = new Sequence;
			for(f in r.fields){
				rargs.add(f.qualifiedFieldName().createRefExpr(false,false));
				rargs.add(f.type.defaultValueAsZExpr());
			}
			return createOperatorApplExpr("_reclit_", rargs);
		}
		if(r.isKindOf(RC!NameType)){
			return r.type.defaultValueAsZExpr();
		}
		if(r.isKindOf(RC!PrimitiveType)){
			var pn = r.name.toLowerCase();
			//RoboChart writes the type as "boolean"; the old comparison with "Boolean" never matched, so bool
			//variables got the default 0 (issue L). The default true is the one of the RoboChart CSP-M generator.
			if(pn = "boolean"){
				return createBooleanExpr(true);
			}
			if(pn = "string"){
				return "''''".createRefExpr(false,false); //the empty string of Isabelle
			}
			//int, nat, real, and a primitive type declared in the model (type T), which the templates declare
			//as type_synonym T = nat: 0, as the CSP-M (typeDefaultValue: "0" for every other primitive type)
			return createNumExpr(0);
		}
		return generatorErrorMarker("default_value", r.name).createRefExpr(false,false);
	}
	
	if(self.type().name = "SeqType"){

	("line 1830, self = "  + self).println();
		//default of Seq(T) is the empty sequence <>, encoded as in createSeqExpr: "<,,>" applied to an empty set
		var seqExpr = new Z!ApplExpr;
		seqExpr.mixFix = true;
		seqExpr.leftExpr = "<,,>".createRefExpr(false,false);
		var emptySet = new Set<Z!Expr>;
		seqExpr.rightExpr = emptySet.createSetExpr();
		return seqExpr;
	}

	if(self.type().name = "SetType"){
		//default of Set(T) is the empty set {}
		var emptySet = new Set<Z!Expr>;
		return emptySet.createSetExpr();
	}

	if(self.type().name = "ProductType"){
		var typeSeq = new Sequence<Z!Expr>;
		for(tp in self.types){
			("line 1840, tp = " + tp).println();
			typeSeq.add(tp.defaultValueAsZExpr());
		}
		return typeSeq.createTupleExpr();
		
	}
	//a total function A -> B: the constant function with the default of B, as the CSP-M
	//(funcToSet(\ x_ @ d, A)); printed (\<lambda>_. d) (_constfun_) (KK, 23 Nov 2026)
	if(self.type().name = "FunctionType"){
		return createOperatorApplExpr("_constfun_", Sequence{self.range.defaultValueAsZExpr()});
	}
	//relation, vector, matrix and any other type: not supported by this generator (KK, 23 Nov 2026)
	return generatorErrorMarker("default_value", self.type().name).createRefExpr(false,false);
	/*
	if(self.type().name = "RelationType"){
	
	}
	if(self.type().name = "FunctionType"){
	
	}
	if(self.type().name = "SetType"){
	
	}
	
	if(self.type().name = "AnyType"){
	
	}
	if(self.type().name = "VectorType"){
	
	}
	if(self.type().name = "MatrixType"){
	
	}
	*/
}

operation createNumExpr(value: Integer): Z!NumExpr{
	var numExpr = new Z!NumExpr;
	numExpr.numeral = new Z!ZNumeral;
	numExpr.numeral.value = value;
	
	return numExpr;
}

operation createBooleanExpr(value: Boolean): Z!RefExpr{
	var boolExpr = new Z!RefExpr;
	boolExpr.mixFix = false;
	boolExpr.explicit = false;
	boolExpr.name = new Z!ZName;
	if(value = true){
		boolExpr.name.word ="True";
	} else {
		boolExpr.name.word ="False";
	}
	
	return boolExpr;
}

//TO be confirmed
//Rule 37, follows the same pattern of Rule 35

operation sharedMemory(v: RC!Variable): Z!ActionPara{

	//25 Nov 2026 (variant (ii), CONTROLLER_PLAN 7.10): the paragraph depends only on the name and the type of v, so
	//two machines that require v (in a controller) share it: it is created once (before, it was printed twice with
	//the same name and text). A second one with another type would be a different process with the same name.
	var existing = Z!ActionPara.all().selectOne(p|p.name.isDefined() and p.name.word = "sharedMemory_" + v.name);
	if(existing.isDefined()){
		return existing;
	}
	return IndividualSharedVarMemory(v).createActionPara("sharedMemory_" + v.name);

}

//Rule 37 auxilary
operation IndividualSharedVarMemory(v: RC!Variable): Z!ParamAction{
	
	
	var commu1  = createOutputCommunicationFromString("get_" + v.name, "value__v", "OUTPUT");
	var choice1 = createPrefixingAction(
						commu1, 
						("sharedMemory_"+v.name).createCallAction(Sequence{"value__v".createRefExpr(false, false)})
						); 
	
	
	
	var commu2  = createInputCommunication("set_" + v.name, "x__v");
	var choice2 = createPrefixingAction(
						commu2, 
						("sharedMemory_"+v.name).createCallAction(Sequence{"x__v".createRefExpr(false, false)})
						);  
						
	var commu3  = createInputCommunication("set_EXT_" + v.name, "x__v");
	var choice3 = createPrefixingAction(
						commu3, 
						("sharedMemory_"+v.name).createCallAction(Sequence{"x__v".createRefExpr(false, false)})
						);  
	
	var choice4 = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	
	var sharedMemory = createAction2("ExtChoiceAction", choice1, createAction2("ExtChoiceAction", choice2, createAction2("ExtChoiceAction", choice3, choice4)));
	
	var action = new Z!ParamAction;
	action.isParamCommand = true;
	action.circusAction = sharedMemory;
	
	var value = new RC!Variable;
	value.name = "value__v";
//	("line 1745,  v.type = " + v.type).println();
//	("line 1746,  v.type.type() = " + v.type.type()).println();
//	("line 1738,  v.type.type = " + v.type.type).println();
//	("line 1739,  v.type.ref = " + v.type.ref).println();
	value.type = clone(v.type);
//	param.type.ref = clone(v.type.ref);
//	("line 1741,  v.type = " + v.type.type.ref).println();
//	("line 1742,  v.type = " + v.type.type.ref).println();
	("line 1931, value.type = " + value.type).println();
//	("line 1750, param.type.ref = " + param.type.ref).println();
	action.declList = new Z!ZDeclList;
	action.declList.decls.add(createVarDecl(value));
	
	return action;
}



operation nc(stmt: RC!Statement): RC!NodeContainer{
	for(nc in RC!NodeContainer.all()){
		
		for(st in nc.nodes.select(s|s.instanceOf(RC!State))){
			if(st.actions.size()>0){
				for(action in st.actions){
					if(action.action = stmt){
						return nc;
					}
				}
			}
		}	
		
		for(tr in nc.transitions){
			if(tr.action = stmt){
				return nc;
			}			
		}
	}
}

//true iff the statement belongs to a transition action (not to an entry/during/exit action of a state); issue J
operation isOwnedByTransition(stmt: RC!Statement): Boolean{
	var c = stmt;
	while(c.isDefined() and not (c.isKindOf(RC!Transition) or c.isKindOf(RC!Action))){
		c = c.eContainer();
	}
	return c.isDefined() and c.isKindOf(RC!Transition);
}

operation findTrStOwnerOfStmt(stmt: RC!Statement): String{
	//walk up the containment tree so that nested statements (e.g. inside SeqStatement or IfStmt)
	//are also resolved to the Transition or State Action that owns them
	var c = stmt;
	while(c.isDefined() and not (c.isKindOf(RC!Transition) or c.isKindOf(RC!Action))){
		c = c.eContainer();
	}

	if(c.isDefined() and c.isKindOf(RC!Transition)){
		var nc = c.eContainer();
		//The same statement is translated twice: once inside Trans_<nc> (Rule 53) and once inside
		//Transc_<nc> (Rule 53-1, the "Trans core" used for the ddlf check). The assume fallback must
		//return to the process currently being generated, so the prefix is read from the marker that
		//Rule 53 / Rule 53-1 put on the node container before translating its transitions.
		//nc.~transPrefix is an EOL extended property: a runtime-only "label" on the model object,
		//not part of the RoboChart metamodel and never saved to the .rct file.
		var prefix = nc.~transPrefix;
		if(prefix.isUndefined()){
			prefix = "Trans_"; //not called from Rule 53/53-1: default to the full Trans process
		}
		return prefix + nc.FQN();
	}

	if(c.isDefined() and c.isKindOf(RC!Action)){
		var st = c.eContainer();
		var nc = st.eContainer();
		return st.name + nc.FQN();
	}

	("findTrStOwnerOfStmt: no owner found for " + stmt).println();
	return null;
}

