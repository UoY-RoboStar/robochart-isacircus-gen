	var varset: Set<RC!Variable>; 
	
	for(i in context.rInterfaces){
		for(vl in i.variableList.select(l|l.modifier = RC!VariableModifier#VAR)){
			for(v in vl.vars){
				varset.add(v);
			}
		}
	}
	return varset;
}


