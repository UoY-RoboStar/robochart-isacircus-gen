//CSP Rule 55
operation trigger(t: RC!Transition): Z!PrefixingAction{
	var triggerAction;
	var commu;
	var callAction;
	var channel_name;
	
	if(t.trigger = null){
	
		/*************************************
		commu is a dot communication
		CSP semantics funciton: internal.id(t.source)
		CSPM example: internal__!NID_s0
		Circus example: internal__stm0.NID_s0_stm0
		****************************************/
		commu = createOutputCommunicationFromString("internal__" + nc(t).FQN(), "NID_" + t.source.FQN(), "SYNC");
		triggerAction = createPrefixingAction(commu, createSkipAction());
	} else
	//transition trigger event can only be input or simple type
	if(t.trigger._type = CommunicationType#INPUT){
		
		/*************************************
		CSP semantics function: eventId(t.event)__.id(t.soure).in?x
		CSPM example: trigger1__!NID_s0.in?a
		Circus example: trigger1_stm0__in!NID_s0_stm0?a_stm0
		****************************************/
		//Rule 55: the trigger channel of the container of t (triggerChan); before 14 Nov 2026 e.name + "__in"
		channel_name = triggerChan(t.trigger.event, nc(t));
//		channel_name = t.trigger.event.FQN() + "__in";		
		var dot_para = "NID_" + t.source.FQN();

//		var input_var = t.trigger.parameter.name + "_" + nc(t.trigger.parameter).FQN();
		//the line above is commented out because the var name should be in a state machine scope, i.e. as a local var
		var input_var = t.trigger.parameter.name;
//		commu = createOutputInputCommunication(channel_name, output_para,input_var);
		commu = createDotInputCommunication(channel_name, dot_para,input_var);
		
		//Circus example: set_a_stm0!a_stm0
		var inner_channel_name = "set_" + t.trigger.parameter.name;
		
		var expr_string = t.trigger.parameter.name;
		var inner_commu = createOutputCommunicationFromString(inner_channel_name, expr_string, "OUTPUT");
			
		var rightAction = createPrefixingAction(inner_commu, createSkipAction());
		var leftAction = "SSTOP".createCallAction();
		callAction = createAction2("InterruptAction", leftAction, rightAction);
		
		triggerAction = createPrefixingAction(commu, callAction);
	} else
	
	if(t.trigger._type = CommunicationType#SIMPLE){
		//Rule 55: the trigger channel of the container of t (triggerChan); before 14 Nov 2026 e.name + "__in"
		channel_name = triggerChan(t.trigger.event, nc(t));
//		channel_name = t.trigger.event.FQN() + "__in" ;
		var dot_para = "NID_"+ t.source.FQN();
//		commu = createSynchCommunication(channel_name);
		commu = createOutputCommunicationFromString(channel_name, dot_para, "SYNC");
	
		triggerAction = createPrefixingAction(commu, createSkipAction());
	} 
	
	return triggerAction;
}






//CSP Rule 57
operation RC!Junction createJunctionAsActionParas() {
//	var actionParaSeq = new Sequence<Z!ActionPara>;
	
		
	var Inactive = createAction2("InterruptAction", "SSTOP".createCallAction(), createAction2("ExtChoiceAction", ("Activation_"+self.FQN()).createCallAction(), ("Termination_"+self.FQN()).createCallAction()));
	Inactive.createActionPara("InactiveJct_"+self.FQN());
//	actionParaSeq = Sequence{Inactive.createActionPara("Inactive")};
	
		
	var Activation = createPrefixingAction(createSynchCommunication("enter_"+self.FQN()), ("Active_"+self.FQN()).createCallAction());
	Activation.createActionPara("Activation_"+self.FQN());
//	actionParaSeq.add(Activation.createActionPara("Activation"));
	
	var Termination = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	Termination.createActionPara("Termination_"+self.FQN());
//	actionParaSeq.add(Termination.createActionPara("Termination"));
	
	var seqAction1 = createAction2("InterruptAction", "SSTOP".createCallAction(), createPrefixingAction(createSynchCommunication("interrupt_"+self.FQN()), createSkipAction()));
	
	var Active = createAction2("SeqAction", seqAction1, ("InactiveJct_"+self.FQN()).createCallAction());
	Active.createActionPara("Active_"+self.FQN());
//	actionParaSeq.add(Active.createActionPara("Active"));
	
//	var mainActionname = "Inactive";
	
//	var basicProcess = actionParaSeq.createBasicProcess(mainActionname);
//	return basicProcess;
}




//CSP Rule 58
operation RC!Final createFinalAsActionParas() {
//	var actionParaSeq = new Sequence<Z!ActionPara>;
	
	var Inactive = createAction2("InterruptAction", "SSTOP".createCallAction(), createAction2("ExtChoiceAction", ("Activation_"+self.FQN()).createCallAction(), ("Termination_"+self.FQN()).createCallAction()));
	Inactive.createActionPara("InactiveFn_"+self.FQN());
//	actionParaSeq = Sequence{Inactive.createActionPara("Inactive")};
	
		
	var Activation = createPrefixingAction(createSynchCommunication("enter_"+self.FQN()), ("Entering_"+self.FQN()).createCallAction());
	Activation.createActionPara("Activation_"+self.FQN());
//	actionParaSeq.add(Activation.createActionPara("Activation"));
	
	
	var Termination = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	Termination.createActionPara("Termination_"+self.FQN());
//	actionParaSeq.add(Termination.createActionPara("Termination"));
	
		
	var Entering = createPrefixingAction(createSynchCommunication("entered_" + self.FQN()), ("Active_"+self.FQN()).createCallAction());
	Entering.createActionPara("Entering_"+self.FQN());
//	actionParaSeq.add(Entering.createActionPara("Entering"));
	
	
	var rightAction = createAction2("ExtChoiceAction", ("Termination_"+self.FQN()).createCallAction(), createPrefixingAction(createSynchCommunication("interrupt_"+self.FQN()), ("Interrupted_"+self.FQN()).createCallAction()));
	
	var Active = createAction2("InterruptAction", "SSTOP".createCallAction(), rightAction);
	Active.createActionPara("Active_"+self.FQN());
//	actionParaSeq.add(Active.createActionPara("Active"));
	
	var rightAction2 = createPrefixingAction(createSynchCommunication("exit_"+ nc(self).FQN()), createPrefixingAction(createSynchCommunication("exited_"+ nc(self).FQN()), ("InactiveFn_"+self.FQN()).createCallAction()));
	
	var Interrupted = createAction2("InterruptAction", "SSTOP".createCallAction(), rightAction2);
	Interrupted.createActionPara("Interrupted_"+self.FQN());
//	actionParaSeq.add(Interrupted.createActionPara("Interrupted_"+self.FQN()));
	
//	var mainActionname = "Inactive";
//	
//	var basicProcess = actionParaSeq.createBasicProcess(mainActionname);
//	return basicProcess;
}




//CSP Rule 59
operation RC!State createSimpleStateAsActionParas() {
//	var actionParaSeq = new Sequence<Z!ActionPara>;
	
	var Inactive = createAction2("InterruptAction", "SSTOP".createCallAction(), createAction2("ExtChoiceAction", ("Activation_"+self.FQN()).createCallAction(), ("Termination_"+self.FQN()).createCallAction()));
	Inactive.createActionPara("Inactive_"+self.FQN());
//	actionParaSeq.add(InactivePara);
	
	var Activation = createPrefixingAction(createSynchCommunication("enter_"+self.FQN()), ("Active_"+self.FQN()).createCallAction());
	Activation.createActionPara("Activation_"+self.FQN());
//	actionParaSeq.add(Activation.createActionPara("Activation"));
	
	
	var Termination = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	Termination.createActionPara("Termination_"+self.FQN());
//	actionParaSeq.add(Termination.createActionPara("Termination"));
	
	var Active = createAction2("SeqAction", self.createStateActionAsCircusAction("EntryAction"), createAction2("SeqAction", ("Behaviour_"+self.FQN()).createCallAction(), ("Exiting_"+self.FQN()).createCallAction()));
	Active.createActionPara("Active_"+self.FQN());
//	actionParaSeq.add(Active.createActionPara("Active"));
	
	
	var Behaviour = createPrefixingAction(createSynchCommunication("entered_" + self.FQN()), ("During_"+self.FQN()).createCallAction());
	Behaviour.createActionPara("Behaviour_" + self.FQN());
//	actionParaSeq.add(Behaviour.createActionPara("Behaviour"));
	
	var duringLeft = createAction2("SeqAction", self.createStateActionAsCircusAction("DuringAction"), "SSTOP".createCallAction());
	var duringRight = createPrefixingAction(createSynchCommunication("interrupt_" + self.FQN()), createSkipAction());
	var During = createAction2("InterruptAction", duringLeft, duringRight);
	During.createActionPara("During_" + self.FQN());
//	actionParaSeq.add(During.createActionPara("During"));
	
	
	
	var exitingAction1 = createAction2("InterruptAction", "SSTOP".createCallAction(), createPrefixingAction(createSynchCommunication("exit_"+ nc(self).FQN()), createSkipAction()));
	var exitingAction2 = self.createStateActionAsCircusAction("ExitAction");
	// exited is offered under SSTOP: (SSTOP /\ (exited -> Skip)) ; Inactive, as RoboTool's CSP-M
	// (share__choice(exited -> SKIP) ; Inactive). Changed 6 Nov 2026 to follow the common protocol confirmed
	// by Pedro: in a composite state the outer during action may write shared variables after the inner
	// state's exit and before its exited, so the node must accept share there. This aligns the output with
	// the CSP-M; it is not a bug fix. For flat models both forms are semantically acceptable.
	// Before: exited -> Inactive (exited not under SSTOP).
	var exitingAction3 = createAction2("SeqAction",
		createAction2("InterruptAction", "SSTOP".createCallAction(),
			createPrefixingAction(createSynchCommunication("exited_"+ nc(self).FQN()), createSkipAction())),
		("Inactive_" + self.FQN()).createCallAction());
	var Exiting = createAction2("SeqAction", exitingAction1, createAction2("SeqAction", exitingAction2, exitingAction3));
	Exiting.createActionPara("Exiting_" + self.FQN());
//	actionParaSeq.add(Exiting.createActionPara("Exiting"));
	
//	var mainActionname = "Inactive";
//	
//	var basicProcess = actionParaSeq.createBasicProcess(mainActionname);
//	return basicProcess;
}


//Rule 60, implemented as RoboTool's CSP-M writes a composite state (15 Nov 2026; before, a draft that did
//not run). Inactive, Activation, Termination, Active and Exiting are those of a simple state (Rule 59).
//Checked against the manual (RoboChart Reference Manual, Rule 60) on 15 Nov 2026. As the manual: the
//frame; During = (SStop /\ ([] e : enteredSS(s) . e -> Skip)) ; entered.id(s) -> ((RUN(enteredSS(s)) |||
//[[s.during]] ; SStop) /\ interrupt.id(s) -> (SStop /\ end -> Skip)); Behaviour = ([[s]]NC in the meta
//parallel with During) \ (enteredSS(s), end).
//Differences from the manual, all following RoboTool's CSP-M:
//(1) Exiting, as for Rule 59: the manual has (SStop /\ exit -> Skip) ; [[s.exit]] ; exited -> Inactive,
//    exited NOT under SStop; here (SSTOP /\ (exited -> Skip)) ; Inactive (comment at Exiting). (The final
//    state, Rule 58, is generated as the manual writes it: SStop /\ exit -> exited -> Inactive.)
//(2) Behaviour: the manual writes |[vars(s.nodes) | enteredSS(s), end, interrupt | vars(s.during)]|, i.e.
//    Definition C.2.2 with the variables of the inner nodes on one side and those of the during action on
//    the other; here all variables of the machine on both sides (see createTwoSidedWriteSync).
//(3) the synchronisation set of Behaviour: the manual has the whole channel interrupt; here the one event
//    interrupt_<state>, the only interrupt event of the inner level that is left after the renaming tidsR
//    of Rule 41.
//(4) enteredSS(s): the manual takes entered.id(x) for all x in s.nodes; here, and in the CSP-M, for the
//    states (and final states) only: a junction has no entered event (Rule 57).
//RunEntered is RUN(enteredSS(s)) of the manual, written as a recursive paragraph (generator convention).
operation RC!State createCompositeStateAsActionParas(){
	
	
	/*******************************
	Inactive
	*******************************/
	var Inactive = createAction2("InterruptAction", "SSTOP".createCallAction(), createAction2("ExtChoiceAction", ("Activation_"+self.FQN()).createCallAction(), ("Termination_"+self.FQN()).createCallAction()));
	Inactive.createActionPara("Inactive_"+self.FQN());
	
	
	
	/*******************************
	Activation
	*******************************/
	var Activation = createPrefixingAction(createSynchCommunication("enter_"+self.FQN()), ("Active_"+self.FQN()).createCallAction());
	Activation.createActionPara("Activation_"+self.FQN());
	
	
	/*******************************
	Termination
	*******************************/
	var Termination = createPrefixingAction(createSynchCommunication("terminate"), createSkipAction());
	Termination.createActionPara("Termination_"+self.FQN());
	
	
	/*******************************
	Active
	*******************************/
	var Active = createAction2("SeqAction", self.createStateActionAsCircusAction("EntryAction"), createAction2("SeqAction", ("Behaviour_"+self.FQN()).createCallAction(), ("Exiting_"+self.FQN()).createCallAction()));
	Active.createActionPara("Active_"+self.FQN());
	
	
	/*******************************
	Behaviour (15 Nov 2026; checked against RoboTool's CSP-M of the test models c1 to c6 and of
	Adaptation_Plan, CSP generator 3.1.0.202608041330)

	Behaviour_S = ( ncBehaviour_S [share -> share and every setR_v] [set_v -> setL_v]
	                  [| enteredSS(S), interrupt_S, terminate, share, setL_v, setR_v |]
	                During_S      [share -> share and every setL_v] [set_v -> setR_v]
	              ) [setL_v -> set_v] [setR_v -> set_v]  \ (enteredSS(S), terminate)

	ncBehaviour_S is Rule 40 with the state as node container: the inner nodes with the inner Trans (Rule 41),
	the inner flow events hidden, the inner trigger channels renamed. v ranges over ALL variables declared in
	the machine, on both sides, as in the CSP-M (not reduced by Definition C.2.2).
	interrupt_S, the interrupt of this node, is also the container interrupt of the inner level.
	*******************************/
	var inner = ncBehaviour(self);
	var cs = enteredSS(self).asSet().includingAll(Set{"terminate", "interrupt_" + self.FQN()});
	var Behaviour = createTwoSidedWriteSync(inner.name.word.createCallAction(),
											("During_"+self.FQN()).createCallAction(),
											cs,
											machineVarNames(self));
	Behaviour = Behaviour.createHideAction(enteredSS(self).includingAll(Sequence{"terminate"}));
	var BehaviourPara = Behaviour.createActionPara("Behaviour_" + self.FQN());
	//The check of exit actions of inner states against input triggers (exitTriggerConflicts, 16 Nov 2026) was
	//removed on 23 Nov 2026: the same as the manual and RoboTool's CSP-M, no hint there (header of this file).
	
	
	/*******************************
	RunEntered_S = [] e : enteredSS(S) . e -> RunEntered_S       (RUN(enteredSS(S)) of the CSP-M, as a
	recursive paragraph: no RUN action is needed in the metamodel or in the templates)
	*******************************/
	var runSeq = new Sequence<Z!CircusAction>;
	for(e in enteredSS(self)){
		runSeq.add(createPrefixingAction(createSynchCommunication(e), ("RunEntered_"+self.FQN()).createCallAction()));
	}
	var runAction;
	if(runSeq.size()>1){
		runAction = runSeq.createSequenceAsExtchoiceAction();
	} else {
		runAction = runSeq.at(0);
	}
	runAction.createActionPara("RunEntered_" + self.FQN());
	
	
	/*******************************
	During_S = (SStop /\ ([] e : enteredSS(S) . e -> Skip)) ;
	           entered_S -> ( (RunEntered_S ||| (during action ; SStop))
	                          /\ (interrupt_S -> (SStop /\ (terminate -> Skip))) )
	*******************************/
	//step 1: [] e: enteredSS(s) . e -> Skip
	var extchoiceSeq = new Sequence<Z!CircusAction>;
	for(e in enteredSS(self)){
		extchoiceSeq.add(createPrefixingAction(createSynchCommunication(e), createSkipAction()));
	}
	var ext_choice;
	if(extchoiceSeq.size()>1){
		ext_choice = extchoiceSeq.createSequenceAsExtchoiceAction();
	} else {
		ext_choice = extchoiceSeq.at(0);
	}
	
	//step 2: SStop /\ (step 1)
	var During_act1 = createAction2("InterruptAction", "SSTOP".createCallAction(), ext_choice);
	
	//step 3: [s.during]action ; SStop
	var During_act2 = createAction2("SeqAction", self.createStateActionAsCircusAction("DuringAction"), "SSTOP".createCallAction());
	
	//step 4: RunEntered ||| (during ; SStop)
	var During_act3  = createAction2("InterleaveAction", ("RunEntered_"+self.FQN()).createCallAction(), During_act2);
	
	//step 5: interrupt.id(s) -> (SStop /\ end -> Skip)
	var stopInterruptByEnd = createAction2("InterruptAction", "SSTOP".createCallAction(), createPrefixingAction(createSynchCommunication("terminate"), createSkipAction()));
	var During_act4 = createPrefixingAction(createSynchCommunication("interrupt_" + self.FQN()), stopInterruptByEnd);
	
	//step 6: interruption 
	var During_act5 = createAction2("InterruptAction", During_act3, During_act4);
	
	//step 7: entered.id(s) -> ()
	During_act5 = createPrefixingAction(createSynchCommunication("entered_"+self.FQN()), During_act5);
	
	//step 8: sequential
	var During = createAction2("SeqAction", During_act1, During_act5);
	
	During.createActionPara("During_" + self.FQN());
	
	
	/*******************************
	Exiting
	*******************************/
	var exitingAction1 = createAction2("InterruptAction", "SSTOP".createCallAction(), createPrefixingAction(createSynchCommunication("exit_" + nc(self).FQN()), createSkipAction()));
	var exitingAction2 = self.createStateActionAsCircusAction("ExitAction");
	// exited is offered under SSTOP: (SSTOP /\ (exited -> Skip)) ; Inactive, as RoboTool's CSP-M
	// (share__choice(exited -> SKIP) ; Inactive). Changed 6 Nov 2026 to follow the common protocol confirmed
	// by Pedro: in a composite state the outer during action may write shared variables after the inner
	// state's exit and before its exited, so the node must accept share there. This aligns the output with
	// the CSP-M; it is not a bug fix. For flat models both forms are semantically acceptable.
	// Before: exited -> Inactive (exited not under SSTOP).
	var exitingAction3 = createAction2("SeqAction",
		createAction2("InterruptAction", "SSTOP".createCallAction(),
			createPrefixingAction(createSynchCommunication("exited_"+ nc(self).FQN()), createSkipAction())),
		("Inactive_" + self.FQN()).createCallAction());
	var Exiting = createAction2("SeqAction", exitingAction1, createAction2("SeqAction", exitingAction2, exitingAction3));
	Exiting.createActionPara("Exiting_" + self.FQN());

}


//Auxiliary of Rule 60 (generator convention, not a rule of the manual).
//The machine (state machine or operation) that a node container belongs to: the container itself, or the
//enclosing machine of a composite state.
operation machineOf(nc: RC!NodeContainer): RC!NodeContainer{
	var c = nc;
	while(c.instanceOf(RC!State)){
		c = c.eContainer();
	}
	return c;
}

//Auxiliary of Rule 60 (Behaviour).
//The names of the variables of the machine of nc, as allVariables(stm) of RoboTool's CSP-M generator
//(GeneratorUtils.xtend, allVariables, https://github.com/UoY-RoboStar/robochart-csp-gen/blob/a6412b40c83ded4ab2c18c2b9bd28575ec270983/circus.robocalc.robochart.generator.csp/src/circus/robocalc/robochart/generator/csp/untimed/GeneratorUtils.xtend#L483),
//in its order: the parameters of an operation definition, the variables of the machine itself, of the
//interfaces it provides and of the interfaces it uses (16 Nov 2026: parameters and provided interfaces
//added). For a state machine there are no parameters, and the RoboChart validator forbids state machines and
//operation definitions to provide interfaces ("... cannot provide interface"), so for every model accepted
//by RoboTool the provided part is empty; it is kept to follow the source. After the FQN pre-processing
//v.name is the qualified name of a variable of a state machine.
//Required interfaces (stm.RInterfaces, the last loop of allVariables) added on 16 Nov 2026 (generator issue EE;
//docs/SEMANTICS_DIFFERENCES.md entry 2): before, they were missing. All variables of the machine are a safe
//superset (Pedro, 16 Nov 2026). No generated model changes (Adaptation_Plan has only defined interfaces; c7,
//the only test model with requires, cannot be generated yet, issue DD). A required variable whose name is
//already in the list is not added again (stmVars of the CSP-M collects allVariables in a set).
operation machineVarNames(nc: RC!NodeContainer): Sequence<String>{
	var m = machineOf(nc);
	var names = new Sequence<String>;
	if(m.isKindOf(RC!OperationDef)){
		for(v in m.parameters){ names.add(v.name); }
	}
	for(vl in m.variableList){
		if(vl.modifier = RC!VariableModifier#VAR){
			for(v in vl.vars){ names.add(v.name); }
		}
	}
	for(provided_interface in m.pInterfaces){
		for(vl in provided_interface.variableList){
			if(vl.modifier = RC!VariableModifier#VAR){
				for(v in vl.vars){ names.add(v.name); }
			}
		}
	}
	for(defined_interface in m.interfaces){
		for(vl in defined_interface.variableList){
			if(vl.modifier = RC!VariableModifier#VAR){
				for(v in vl.vars){ names.add(v.name); }
			}
		}
	}
	//required interfaces (16 Nov 2026, generator issue EE): the last loop of allVariables
	for(required_interface in m.rInterfaces){
		for(vl in required_interface.variableList){
			if(vl.modifier = RC!VariableModifier#VAR){
				for(v in vl.vars){ if(not names.includes(v.name)){ names.add(v.name); } }
			}
		}
	}
	return names;
}

//Rule 60 (Behaviour), Definition C.2.2 in its two-sided form. DIFFERENT FROM THE MANUAL (p. 53, difference
//R60-vars of docs/SEMANTICS_DIFFERENCES.md): Rule 60 has |[vars(s.nodes) | cs | vars(s.during)]|, for which
//Definition C.2.2 uses setL for the variables in vars(s.nodes) /\ vars(s.during) and setR likewise; here,
//as in RoboTool's CSP-M (CStateGenerator.xtend compileCompositeStateBehaviour 340-356, stmVars 453-458,
//GeneratorUtils.xtend allVariables 483-511, robochart-csp-gen a6412b40c8), ALL variables of the machine
//are used on both sides (c5: also for a composite state that uses no variable).
//Reasons: (1) ours: During is not under SStop at its prefix entered_<state>; with smaller sets a write of
//the inner machine at that moment would not be synchronised with During. (2) Pedro, 16 Nov 2026: the
//formula of the manual is right in intent but incomplete: vars(s.nodes) should also contain the variables
//read and written by the definitions of the software operations called inside the composite state
//(including the variables the machine provides and those required by the called operations); the CSP
//semantics of the nodes alone, or of the operations alone, is not enough; the CSP-M uses all variables of
//the machine for convenience, a superset, which guarantees the right behaviour. Decision (Fang, 16 Nov
//2026): keep allVariables as the CSP-M.
//The two-sided write synchronisation of Behaviour of a composite state (Rule 60), as RoboTool's CSP-M
//writes it:
//  ( P [share -> share, setR_v...] [set_v -> setL_v...]  [| cs, share, setL_v..., setR_v... |]
//    Q [share -> share, setL_v...] [set_v -> setR_v...] ) [setL_v -> set_v...] [setR_v -> set_v...]
//for all v in vs. createMetaParallelAction (Rule 41) is not used: its part for the right-hand writes adds
//the pairs to the renaming of P after P has been renamed.
operation createTwoSidedWriteSync(P: Z!CircusAction, Q: Z!CircusAction, cs: Set<String>, vs: Sequence<String>): Z!CircusAction{
	var PpairR = Sequence{"share"}; var PpairL = Sequence{"share"};
	var QpairR = Sequence{"share"}; var QpairL = Sequence{"share"};
	for(v in vs){ PpairR.add("share"); PpairL.add("setR_"+v); }
	for(v in vs){ PpairR.add("set_"+v); PpairL.add("setL_"+v); }
	for(v in vs){ QpairR.add("share"); QpairL.add("setL_"+v); }
	for(v in vs){ QpairR.add("set_"+v); QpairL.add("setR_"+v); }
	var channel_names = new Set<String>;
	channel_names.addAll(cs);
	channel_names.add("share");
	for(v in vs){ channel_names.add("setL_"+v); channel_names.add("setR_"+v); }
	var par = createParallelAction(channel_names, P.createRenameAction(PpairR, PpairL), Q.createRenameAction(QpairR, QpairL));
	if(vs.size() = 0){
		return par;
	}
	var outR = new Sequence<String>; var outL = new Sequence<String>;
	for(v in vs){ outR.add("setL_"+v); outL.add("set_"+v); }
	for(v in vs){ outR.add("setR_"+v); outL.add("set_"+v); }
	return par.createRenameAction(outR, outL);
}

operation createParallelAction(cs: Set<String>,
							   ns1: Set<String>,
							   ns2: Set<String>,
							   left:Z!CircusAction,
							   right:Z!CircusAction): Z!CircusAction{
	
	var action = new Z!ParallelAction;
	action.channelSet = createChannelSet(createBasicChannelSetExpr(cs));
	action.leftAction = left;
	action.rightAction = right;
	
	action.leftNameSet = createNameSet(ns1);
	action.rightNameSet = createNameSet(ns2);
	
	return action;
}


operation Z!CircusAction createActionPara(name: String): Z!ActionPara{
	var para = new Z!ActionPara;
	para.name = name.createZName();
	para.circusAction = self;
	
	return para;
}


//to convert action list into a process
operation Sequence<Z!Para> createBasicProcess(mainActionName: String): Z!BasicProcess{
	
//	var list.paras = new Sequence<Z!Para>;
//	list.paras = self;
	var basicProcess = new Z!BasicProcess;
	
	basicProcess.mainAction = mainActionName.createCallAction();
	
	var list = new Z!ZParaList;
	basicProcess.paraList = list;
	basicProcess.paraList.paras = new Sequence<Z!Para>;
	basicProcess.paraList.paras = self;
		
	return basicProcess;
}




operation Sequence<Z!CircusAction> createSequenceAsExtchoiceAction(): Z!ExtChoiceAction{
	var extchoiceAction;
	var size = self.size();
	var i = 0;
	extchoiceAction = createAction2("ExtChoiceAction", self.at(0), self.at(1));
	i = i + 2;
	if(size > 2){
		while(i<size){
			extchoiceAction = createAction2("ExtChoiceAction", extchoiceAction, self.at(i));
			i = i + 1;
		}
	}
	return extchoiceAction;
}


//This is not used yet
operation Sequence<Z!CircusAction> createSequenceAsSeqAction(): Z!SeqAction{
	var seqAction;
	var size = self.size();
	var i = 0;
	seqAction = createAction2("SeqAction", self.at(0), self.at(1));
	i = i + 2;
	if(size > 2){
		while(i<size){
			seqAction = createAction2("SeqAction", seqAction, self.at(i));
			i = i + 1;
		}
	}
	return seqAction;
}


operation RC!NodeContainer vguards(): Set<String>{
	var vguards = new Set<String>;
	for (tr in self.transitions){
		vguards= vguards.includingAll(usedVariablesInExpr(tr.condition,self));
	}

	return vguards;
}




