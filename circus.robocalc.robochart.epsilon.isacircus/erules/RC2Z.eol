/* FQN pre-processing (restored from the commented-out block further below).
   Every variable and constant declared directly in a state machine is renamed to <name>_<stm FQN>,
   so all generated names (get_/set_/setL_/setR_ channels, Memory, guards, Isabelle variables) stay
   unique even when two state machines declare a variable with the same name.
   All references (RefExp.ref, VarRef.name, trigger parameters) point to the Variable objects,
   so they pick up the new names automatically; this must run before any transformation below.
   Deliberately NOT restored from the old block:
   - declareSharedVarAndConstAsLocalVar / Shared2FQLocalVariablesAndConst: shared (required) variables
     are now handled by sharedMemory_x and set_EXT_x, and the name-based redirection breaks on x[i] = e;
   - renaming events: event channels keep their names (they are matched by connections). */
for(stm in RC!StateMachineDef.all()){
	FQNllLocalVariables(stm);
}

//To consider different configuration of the RoboChart models which can be a module, or controller, or just a stm.
if(RC!RCModule.all().size()>0){
	"line 165, createModuleAsProcessPara(m) is run".println();
	for(m in RC!RCModule.all()){
		createModuleAsProcessPara(m);
	}
} else 
if(RC!ControllerDef.all().size()>0){
	"line 171, createControllerAsProcessPara(c) is run".println();
	for(c in RC!ControllerDef.all()){
		createControllerAsProcessPara(c);
	}
} else
if(RC!StateMachineDef.all().size()>0){
	"line 177, createStateMachineDefAsActionPara(stm) is run".println();
	for(stm in RC!StateMachineDef.all()){
		createStateMachineDefAsActionPara(stm);
	}
}

