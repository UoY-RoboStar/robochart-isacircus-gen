operation RC!SeqExp createSeqExpr(): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = true; //CZT: C.6.21 (Function Operator Application). 
	
	expr.leftExpr = "<,,>".createRefExpr(false,false);

	var setExpr = new Z!SetExpr;
	var exprList = new Z!ZExprList;
	var exprs = new Sequence<Z!Expr>;
	exprs = Sequence{};
	
	//to do
	var i = 1;//in CZT, this index starts from 1, why?
	for(v in self.values){

		var seq = new Sequence<Z!Expr>;
		seq.add(createNumExpr(i));//index of the element
		seq.add(v.createExpr());//element
		exprs.add(seq.createTupleExpr());//Z list is a list of tupleExpr (index and value)
		i++;
	}
	exprList.exprs = exprs;
	setExpr.exprList = exprList;
	expr.rightExpr = setExpr;	

	
	return 	expr;
}

operation RC!Not createNotExpr():Z!ApplExpr{
	return self.createUnaryApplExpr("Not_");
}	
 	
operation RC!Neg createNegExpr():Z!ApplExpr{
	return self.createUnaryApplExpr("-_");
}	





operation RC!TupleExp createTupleExpr():Z!TupleExpr{
    var expr = new Z!TupleExpr;
	var exprList = new Z!ZExprList;
	var exprs = new Sequence<Z!Expr>;
	exprs = Sequence{};
	
	for(v in self.values){
		exprs.add(v.createExpr());
	}
	exprList.exprs = exprs;
	expr.exprList = exprList;
	
	return expr;
}





//ELSE must be removed, otherwise the program runs for a very long time 
operation RC!Expression createExpr():Z!Expr{
	if(self.isTypeOf(RC!LessThan)){
		return self.createLessThanExpr();
	} //else 
	if(self.isTypeOf(RC!GreaterThan)){
		return self.createGreaterThanExpr();
	} //else 
	if(self.isTypeOf(RC!LessOrEqual)){
		return self.createLessOrEqualExpr();
	} //else 
	if(self.isTypeOf(RC!GreaterOrEqual)){
		return self.createGreaterOrEqualExpr();
	} //else 
	if(self.isTypeOf(RC!Equals)){
		return self.createEqualsExpr();
	} //else 
	if(self.isTypeOf(RC!Different)){
		return self.createNequalExpr();
	} //else 
	if (self.isTypeOf(RC!And)){
		return self.createAndExpr();
	} //else 
	if (self.isTypeOf(RC!Or)){
		return self.createOrExpr();
	} //else 
	if (self.isTypeOf(RC!Not)){
		return self.createNotExpr();
	} //else 
	if (self.isTypeOf(RC!Plus)){
		return self.createPlusExpr();
	} //else 
	if (self.isTypeOf(RC!Minus)){
		return self.createMinusExpr();
	} //else 
	
	if (self.isTypeOf(RC!Mult)){
		return self.createMultExpr();
	} //else 
	
	if (self.isTypeOf(RC!Div)){
		return self.createDivExpr();
	} //else
	
	if (self.isTypeOf(RC!Modulus)){
		return self.createModExpr();
	} //else
	
	if (self.isTypeOf(RC!Neg)){
		return self.createNegExpr();
	} //else
	
	if(self.isTypeOf(RC!Iff)){
	 return self.createIffExpr();
	} //else
	
	if(self.isTypeOf(RC!Implies)){
		return self.createImpliesExpr();
	} //else
	
	if(self.isTypeOf(RC!IntegerExp)){
		return self.createNumExpr();
	} //else
	
	if(self.isTypeOf(RC!RefExp)){
	("line 7410, self = " + self).println();
	("line 7410, self.ref = " + self.ref).println();
	//self.ref may be a let Declaration, which has no type
		return self.ref.name.createRefExpr(false, false);
	} //else

	if(self.isTypeOf(RC!Cat)){
		return self.createApplExpr("_cat_");
	} //else

	if(self.isTypeOf(RC!LetExpression)){
		return self.createLetExpr();
	} //else

	if(self.isTypeOf(RC!IfExpression)){
		return self.createCondExpr();
	} //else
	
	if(self.isTypeOf(RC!BooleanExp)){
		return self.createBooleanExpr();
	} //else
	
	if(self.isTypeOf(RC!FloatExp)){
		return self.createFloatExpr();
	} //else
	
	if(self.isTypeOf(RC!ParExp)){
		return self.exp.createExpr();
	} //else
	
	if(self.isTypeOf(RC!EnumExp)){
		return self.createEnumExpr();
	} //else
	
	//Fix of generator issue MM (23 Nov 2026): a literal with arguments, Shape::Circle(1.0), is a CallExp whose
	//function is the EnumExp; translated to the constructor application (Circle 1.0) (_conapp_, printed by the
	//templates as the application of the constructor to its arguments). Before, the generation stopped.
	if(self.isTypeOf(RC!CallExp) and self.`function`.isTypeOf(RC!EnumExp)){
		var cargs = Sequence{self.`function`.literal.name.createRefExpr(false,false)};
		for(arg in self.args){
			cargs.add(arg.createExpr());
		}
		return createOperatorApplExpr("_conapp_", cargs);
	} //else

	if(self.isTypeOf(RC!CallExp)){
		"line 7080 executed".println();
		return self.createCallExpr();
	} //else

	//Fix of generator issue LL (23 Nov 2026, branch composite-states): field access r.f (RC!Selection) is the
	//field selection of Isabelle, printed (R.f r) by the templates (BindSelExpr) with the field name QUALIFIED
	//by the record type (two records may have a field of the same name, NN); a record literal R(| f = e, ... |)
	//(RC!RecordExp) is the record construction \<lparr>R.f = e, ...\<rparr> (_reclit_), the fields in the order
	//of the declaration (Isabelle requires it). Before, both stopped the generation (createExpr returned
	//nothing: "The 'no null' constraint is violated"), on main as well.
	if(self.isTypeOf(RC!Selection)){
		if(self.member.isKindOf(RC!Field)){
			var sel = new Z!BindSelExpr;
			sel.expr = self.receiver.createExpr();
			sel.name = self.member.qualifiedFieldName().createZName();
			return sel;
		}
		return generatorErrorMarker("unsupported_selection", self.member.name).createRefExpr(false,false);
	} //else
	if(self.isTypeOf(RC!RecordExp)){
		var rargs = new Sequence;
		for(f in self.record.fields){
			var d = self.definitions.selectOne(x | x.field = f);
			rargs.add(f.qualifiedFieldName().createRefExpr(false,false));
			if(d.isDefined()){
				rargs.add(d.value.createExpr());
			} else {
				rargs.add(generatorErrorMarker("missing_field", f.name).createRefExpr(false,false));
			}
		}
		return createOperatorApplExpr("_reclit_", rargs);
	} //else
	//a string literal "abc" is the Isabelle string ''abc'' (needed with KK: strings get a default)
	if(self.isTypeOf(RC!StringExp)){
		return ("''" + self.value + "''").createRefExpr(false,false);
	} //else
	
	if(self.isTypeOf(RC!SeqExp)){
		return self.createSeqExpr();
	} 
	
	if(self.isTypeOf(RC!TupleExp)){
			return self.createTupleExpr();
		}
	if(self.isTypeOf(RC!ArrayExp)){
	("line 7408,self = "+ self).println();
	("line 7408,self.value = "+ self.value).println();
		//the indexed value may be a variable, a let name, a parenthesised expression or a call,
		//e.g. (imagesWithLight[k])[2] or (IDEAL_LIGHTING(model))[1],
		//so decide tuple selection vs sequence application from its RoboChart type
		var base_type = self.value.rcType();
		("line 7420, base type of the indexed value = " + base_type).println();
		if(base_type.isDefined() and base_type.isKindOf(RC!ProductType)){
			return self.createTupleSelExprGeneral();
		}
		if(base_type.isDefined() and base_type.isKindOf(RC!SeqType)){
			return self.createApplExprforSeqMemberGeneral();
		}
		("createExpr: cannot determine the type indexed by " + self + ", value = " + self.value).println();
	}
	//TO DO
/*	if(self.isTypeOf(RC!IfExpression)  or 
	   self.isTypeOf(RC!ResultExp) or 
	   self.isTypeOf(RC!Selection) or 
	   self.isTypeOf(RC!ArrayExp)  or 
	   self.isTypeOf(RC!ClockExp) ){
*/
	//		return self.createUnaryExpr();
	//	} 
}


//TupleExpr is �tuple extension expression� in CZT model
/*
RoboChart example: 
var intPair : nat * nat
CZT example: 
\begin{axdef}
  intPair : \num \cross \num
\where
  intPair = (2, 3)
\end{axdef}
where (2,3) is �tuple extension expression�
*/
operation Sequence<Z!Expr> createTupleExpr(): Z!TupleExpr{
	var tupleExpr = new Z!TupleExpr;
	tupleExpr.exprList = new Z!ZExprList;
	("line 4044 self = " + self).println();
//	("line 4044 self.name = " + self.name).println();
	tupleExpr.exprList.exprs = self;
	return tupleExpr;

}



//TupleSelExpr is �tuple selection expression� in CZT model
/*
RoboChart example: 
var intPair : nat * nat
transition t1
	condition intPair[1] == 10
CZT example: 
intPair.1 = 10

where intPair.1 is �tuple selection expression�
*/
operation RC!ArrayExp createTupleSelExpr(v_name: String): Z!TupleSelExpr{
	var tupleSelExpr = new Z!TupleSelExpr;
	tupleSelExpr.expr = v_name.createRefExpr(false,false);
	("line 7481, TupleSelExpr.parameters.at(0).value = " + self.parameters.at(0).value).println();
	tupleSelExpr.numeral = new Z!ZNumeral;
	tupleSelExpr.numeral.value = self.parameters.at(0).value;
	return tupleSelExpr;

}


//ApplExpr is �application expression� in CZT model
/*
RoboChart example: 
var seqtest: Seq(nat) = <10,20,50>

CZT example: 
\begin{axdef}
  intList : \seq_1 \num
\where
  intList = \langle 20, 30 \rangle
\end{axdef}
...
\circelse intList~1 = intList~2

where intList~1 is �application expression�
*/
operation RC!ArrayExp createApplExprforSeqMember(v_name: String): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = false; //CZT: C.6.22 (Application)
	
	expr.leftExpr = v_name.createRefExpr(false,false);

	//a literal index such as x[2] stays a NumExpr (C.6.30);
	//a non-literal index such as x[model] or x[pos+1] is transformed as a general expression
	if(self.parameters.at(0).isTypeOf(RC!IntegerExp)){
		expr.rightExpr = new Z!NumExpr;
		expr.rightExpr.numeral = new Z!ZNumeral;
		expr.rightExpr.numeral.value = self.parameters.at(0).value;
	} else {
		expr.rightExpr = self.parameters.at(0).createExpr();
	}
	
	return 	expr;

}

/******************************************
General indexing, let and conditional expressions

These generalise createTupleSelExpr/createApplExprforSeqMember above, which only
accept a variable name as the indexed value.
***********************************************/

//RoboChart type of an expression, for the cases needed to decide how x[i] is indexed.
//Returns null when the type cannot be determined.
operation RC!Expression rcType(): RC!Type{
	if(self.isTypeOf(RC!RefExp)){
		if(self.ref.isKindOf(RC!Function)){
			return null; //a function name on its own, not its result
		}
		if(self.ref.isKindOf(RC!TypedNamedElement)){
			return self.ref.type.resolveType();
		}
		if(self.ref.isKindOf(RC!Declaration)){ //name introduced by let
			return self.ref.value.rcType();
		}
		return null;
	}
	if(self.isTypeOf(RC!ParExp)){
		return self.exp.rcType();
	}
	if(self.isTypeOf(RC!ArrayExp)){
		var t = self.value.rcType();
		if(t.isUndefined()){
			return null;
		}
		if(t.isKindOf(RC!SeqType)){
			return t.domain.resolveType();
		}
		if(t.isKindOf(RC!ProductType) and self.parameters.first().isTypeOf(RC!IntegerExp)){
			return t.types.at(self.parameters.first().value - 1).resolveType();
		}
		return null;
	}
	if(self.isTypeOf(RC!CallExp)){
		var f = self.`function`;
		if(f.isTypeOf(RC!RefExp) and f.ref.isKindOf(RC!Function)){ //function declaration: its type is the result type
			return f.ref.type.resolveType();
		}
		var ft = f.rcType(); //constant/variable of function type, e.g. IDEAL_LIGHTING : nat -> real * real
		if(ft.isDefined() and ft.isKindOf(RC!RelationType)){
			return ft.range.resolveType();
		}
		return null;
	}
	if(self.isTypeOf(RC!LetExpression)){
		return self.expression.rcType();
	}
	if(self.isTypeOf(RC!Selection) and self.member.isKindOf(RC!Field)){ //23 Nov 2026 (LL): r.f has the type of f
		return self.member.type.resolveType();
	}
	if(self.isTypeOf(RC!IfExpression)){
		return self.ifexp.rcType();
	}
	return null;
}

//follow named types (NameType) to the type they stand for
operation RC!Type resolveType(): RC!Type{
	if(self.isTypeOf(RC!TypeRef) and self.ref.isTypeOf(RC!NameType)){
		return self.ref.type.resolveType();
	}
	return self;
}

//tuple selection e.n for any expression e, e.g. (IDEAL_LIGHTING(model))[1] -> (IDEAL_LIGHTING model).1
operation RC!ArrayExp createTupleSelExprGeneral(): Z!TupleSelExpr{
	var tupleSelExpr = new Z!TupleSelExpr;
	tupleSelExpr.expr = self.value.createExpr();
	tupleSelExpr.numeral = new Z!ZNumeral;
	if(not self.parameters.first().isTypeOf(RC!IntegerExp)){
		("createTupleSelExprGeneral: tuple index must be a number literal in " + self).println();
	}
	tupleSelExpr.numeral.value = self.parameters.first().value;
	//arity of the tuple (15 Nov 2026, generator issue Y): the number of components of the RoboChart product
	//type of the selected value, which createExpr has checked to be a ProductType before calling this
	//operation. The attribute is a deviation from CZT (see the annotation in circus_metamodel.ecore); the
	//templates need it to print the projection of an n-tuple (tupleSelection.eol). Left at 0 (unknown) if the
	//type cannot be determined.
	var base_type = self.value.rcType();
	if(base_type.isDefined() and base_type.isKindOf(RC!ProductType)){
		tupleSelExpr.arity = base_type.types.size();
	}
	return tupleSelExpr;
}

//sequence application e i for any expression e, e.g. imagesWithLight[imagesWithPoorLight[image]]
operation RC!ArrayExp createApplExprforSeqMemberGeneral(): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = false; //CZT: C.6.22 (Application)
	expr.leftExpr = self.value.createExpr();
	
	if(self.parameters.first().isTypeOf(RC!IntegerExp)){
		expr.rightExpr = new Z!NumExpr;
		expr.rightExpr.numeral = new Z!ZNumeral;
		expr.rightExpr.numeral.value = self.parameters.first().value;
	} else {
		expr.rightExpr = self.parameters.first().createExpr();
	}
	return expr;
}

//CZT: let x == e1 @ e2 is a LetExpr whose schText declares x == e1 (ConstDecl) and whose expr is e2
operation RC!LetExpression createLetExpr(): Z!LetExpr{
	var letExpr = new Z!LetExpr;
	
	var declList = new Z!ZDeclList;
	for(d in self.declarations){
		var constDecl = new Z!ConstDecl;
		constDecl.name = d.name.createZName();
		constDecl.expr = d.value.createExpr();
		declList.decls.add(constDecl);
	}
	
	var schText = new Z!ZSchText;
	schText.declList = declList;
	letExpr.schText = schText;
	
	letExpr.expr = self.expression.createExpr();
	return letExpr;
}

//CZT: if p then e1 else e2 is a CondExpr; the RoboChart condition c becomes the predicate c \in {True}
operation RC!IfExpression createCondExpr(): Z!CondExpr{
	var condExpr = new Z!CondExpr;
	condExpr.pred = self.condition.createExpr().createMemPredEquality();
	condExpr.leftExpr = self.ifexp.createExpr();
	condExpr.rightExpr = self.elseexp.createExpr();
	return condExpr;
}


//Generator issue C: stop with an error if the RoboChart model still contains unresolved cross-references
//(proxies), e.g. to an interface of another file (uses I, import P::*) that was not loaded.
operation checkNoUnresolvedProxies(){
	var problems = new Sequence;
	for(o in RC.allContents()){
		for(ref in o.eClass().getEAllReferences()){
			if(not ref.isContainment() and not ref.isContainer() and not ref.isDerived() and not ref.isTransient()){
				var v = o.eGet(ref);
				var targets = new Sequence;
				if(ref.isMany()){
					targets.addAll(v);
				} else if(v.isDefined()){
					targets.add(v);
				}
				for(t in targets){
					if(t.eIsProxy()){
						problems.add(o.eClass().getName() + "." + ref.getName() + " -> "
							+ new Native("org.eclipse.emf.ecore.util.EcoreUtil").getURI(t));
					}
				}
			}
		}
	}
	if(problems.size() > 0){
		throw "Unresolved references in the RoboChart model (" + problems.size()
			+ "); the files they point to were not loaded:\n" + problems.concat("\n");
	}
}
