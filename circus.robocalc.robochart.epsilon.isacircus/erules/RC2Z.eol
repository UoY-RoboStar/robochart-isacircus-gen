/**************************************************************
 EOL Operations that supports the transformation procedures above 

***************************************************************/
//
/*RoboChart example:

type Chem
type Intensity
datatype GasSensor {
	c : Chem
	i : Intensity
}
enumeration Angle { Left Right Back Front }
*/
//Translation of the user-defined types (records, enumerations, primitive types).
//15 Nov 2026 (generator issue W): not only pkg.types (the package of the selected file) but also the types
//of imported packages that the selected file reaches (typeDeclsToTranslate). This completes issue C
//(25e7662, RctLoader): since then the files of the imported packages are loaded and their references
//resolve, but RC!X.all() still sees only the selected file, so these types were never translated.
operation createTypeDeclPara(pkg:RC!RCPackage){

	for(tp in typeDeclsToTranslate(pkg)){
	
		if(tp.instanceOf(RC!PrimitiveType)){
			var givenPara = new Z!GivenPara;
			givenPara.nameList = createNameList(Sequence{tp.name});
			
		}
		
		if(tp.instanceOf(RC!RecordType)){
			var recordpara = new Z!AxPara;
			recordpara.box = Z!Box#SchBox;
			recordpara.zSchText = new Z!ZSchText;
			
			var declList = new Z!ZDeclList;
			declList.decls.add(tp.createConstDecl());
			
			recordpara.zSchText.declList = declList;
		
		}
		
		if(tp.instanceOf(RC!Enumeration)){
			var literal_seq = new Sequence<String>;
			for(l in tp.literals){
				literal_seq.add(l.name);
			}
			var freetype = createEnumType(tp.name, literal_seq);
			//Fix of generator issue MM (23 Nov 2026, branch composite-states): a literal with parameters,
			//e.g. Circle(real), keeps them: the types are put on the branch (Branch.expr, one n-ary ProdExpr of
			//the parameter types) and the templates print the constructor with one argument per parameter,
			//datatype Shape = Circle "real" | Square. Before, only the name was kept (Circle | Square), on
			//main as well. As RoboTool's CSP-M (datatype Shape = Circle.core_real | Square).
			var bi = 0;
			for(l in tp.literals){
				if(l.types.isDefined() and l.types.size() > 0){
					var ptypes = new Sequence;
					for(pt in l.types){
						ptypes.add(pt.createTypeExpr());
					}
					var pexpr = new Z!ProdExpr;
					pexpr.exprList = new Z!ZExprList;
					pexpr.exprList.exprs = ptypes;
					freetype.branchList.branches.at(bi).expr = pexpr;
				}
				bi = bi + 1;
			}
			
			var freetypePara =  freetype.createEnumTypePara();		
		}
	
	}
}


//Generator convention, not a rule of the manual (15 Nov 2026, generator issue W). The type declarations to
//translate: the types of pkg and the types of other packages (not the toolkits) that are reachable from the
//selected file, i.e. reached by following the references of its objects and of the objects reached
//(an interface it uses, the events of that interface, the record types of their types, the field types of
//those records, ...). Order: dependencies first (Isabelle needs a record declared before a record that uses
//it); otherwise the order of pkg.types, then the order in which the imported types were reached. With no
//imported type the result is pkg.types in its own order, so models without imported types are unchanged.
//The names of imported types are NOT qualified (to keep the existing output); two translated types with
//the same name stop the generation with an error naming both packages.
operation typeDeclsToTranslate(pkg: RC!RCPackage): Sequence{
	var toolkits = Set{"relation_toolkit", "function_toolkit", "sequence_toolkit", "set_toolkit", "core"};
	var imported = new Sequence;
	var visited = new Set;
	var queue = new Sequence;
	for(o in RC.allContents()){ visited.add(o); queue.add(o); }
	var i = 0;
	while(i < queue.size()){
		var o = queue.at(i);
		i = i + 1;
		var op = packageOf(o);
		if(op.isDefined() and toolkits.includes(op.name)){
			continue;
		}
		if(o.isKindOf(RC!TypeDecl) and op.isDefined() and op <> pkg and not imported.includes(o)){
			imported.add(o);
		}
		var next = new Sequence;
		next.addAll(o.eContents());
		for(ref in o.eClass().getEAllReferences()){
			if(not ref.isContainment() and not ref.isContainer() and not ref.isDerived() and not ref.isTransient()){
				var v = o.eGet(ref);
				if(ref.isMany()){
					next.addAll(v);
				} else if(v.isDefined()){
					next.add(v);
				}
			}
		}
		for(t in next){
			if(not visited.includes(t)){
				visited.add(t);
				queue.add(t);
			}
		}
	}
	var candidates = new Sequence;
	candidates.addAll(pkg.types);
	candidates.addAll(imported);
	//name clash: imported type names are not qualified
	var byName = new Map;
	for(t in candidates){
		if(byName.containsKey(t.name) and byName.get(t.name) <> t){
			throw "Type name clash (generator issue W): type " + t.name + " is declared in package "
				+ packageOf(byName.get(t.name)).name + " and in package " + packageOf(t).name
				+ "; types of imported packages are not qualified, so the theory would declare it twice. "
				+ "No theory is generated.";
		}
		byName.put(t.name, t);
	}
	//dependencies first, otherwise the order of candidates
	var ordered = new Sequence;
	var started = new Set;
	for(t in candidates){
		addTypeDeclWithDependencies(t, candidates, ordered, started);
	}
	return ordered;
}

//auxiliary of typeDeclsToTranslate: t after the types of candidates that its contents refer to
operation addTypeDeclWithDependencies(t: Any, candidates: Sequence, ordered: Sequence, started: Set){
	if(started.includes(t)){
		return;
	}
	started.add(t);
	for(c in t.eAllContents()){
		if(c.isKindOf(RC!TypeRef) and candidates.includes(c.ref)){
			addTypeDeclWithDependencies(c.ref, candidates, ordered, started);
		}
	}
	ordered.add(t);
}

//auxiliary of typeDeclsToTranslate: the package that contains o (null if none)
operation packageOf(o: Any): Any{
	var c = o;
	while(c.isDefined() and not c.isKindOf(RC!RCPackage)){
		c = c.eContainer();
	}
	return c;
}

operation RC!RecordType createConstDecl(): Z!ConstDecl{
	var constDecl = new Z!ConstDecl;
	constDecl.name = self.name.createZName();
	
	constDecl.expr = self.fields.createSchExprFromFields();

	return constDecl;
}

//used in createConstDecl
//to create A schema construction expression for record type transformation 
operation Set<RC!Field> createSchExprFromFields(): Z!SchExpr{
	var schExpr = new Z!SchExpr;
	
	schExpr.schText = new Z!ZSchText;
	var declList = new Z!ZDeclList;
	
	for(f in self){
		declList.decls.add(f.createVarDecl());
	}
	schExpr.schText.declList = declList;
	
	return schExpr;

}

//used in createSchExprFromFields
operation RC!Field createVarDecl(): Z!VarDecl{
	var varDecl = new Z!VarDecl;
	
	varDecl.nameList = createNameList(Sequence{self.name});
//	varDecl.expr = self.type.ref.name.createRefExpr(false, false);
	varDecl.expr = self.type.createTypeExpr();
	return varDecl;
}



operation createVarDeclfromString(var_name:String, type_name: String): Z!VarDecl{
	var varDecl = new Z!VarDecl;
	
	varDecl.nameList = createNameList(Sequence{var_name});
	varDecl.expr     = type_name.createTypeExpr();
	return varDecl;
}

//Declarations of the functions (consts in the HOL-CSP theory). The functions of pkg as before (all of them,
//except one named card). Fix of generator issue GG (22 Nov 2026, branch composite-states; present since the
//rules of the ITP 2026 paper): also the functions of imported packages that the model actually calls
//(importedFunctionsToTranslate); before, a call of such a function was printed but the function was not
//declared, and Isabelle stopped with "Extra variables on rhs". Generator convention, as W for types: names are not
//qualified. Returns the warnings about name clashes (attached to a paragraph at the end of the main program).
operation createFunctionDefsAsAxParas(pkg:RC!RCPackage): Sequence{
	var notes = new Sequence;
	var declared = new Map;
	for(f in pkg.functions.select(f|f.name != "card")){
		createAxParaForFunc(f);
		declared.put(f.name, f);
	}
	for(f in importedFunctionsToTranslate(pkg)){
		if(declared.containsKey(f.name)){
			notes.add("Function " + f.name + " of package " + packageOf(f).name + " is not declared: a function of "
				+ "the same name of package " + packageOf(declared.get(f.name)).name + " is declared, and calls of both "
				+ "are printed with the same name (generator issue GG; names of imported functions are not qualified).");
		} else {
			createAxParaForFunc(f);
			declared.put(f.name, f);
		}
	}
	return notes;
}

//Generator issue GG (22 Nov 2026). The functions of other packages (not the toolkits core, set_toolkit,
//sequence_toolkit, function_toolkit, relation_toolkit, which AA translates) that the model calls: the transitive
//closure of the calls (CallExp of a Function) in the selected file (state machines, operations, functions),
//continued through the preconditions and postconditions of the functions reached (and, through eAllContents, any
//other expression a function contains). The functions of pkg are not included (they are all declared anyway), but
//the calls in them are followed. Order: a function after the functions its contents call (dependencies first, as
//typeDeclsToTranslate), otherwise in the order reached. A function named card is skipped, as in pkg.
operation importedFunctionsToTranslate(pkg: RC!RCPackage): Sequence{
	var ordered = new Sequence;
	var started = new Set;
	for(o in RC.allContents()){
		if(o.isKindOf(RC!CallExp)){
			addCalledFunction(o, pkg, ordered, started);
		}
	}
	return ordered;
}

//auxiliary of importedFunctionsToTranslate: the function called by c, after the functions its contents call
operation addCalledFunction(c: Any, pkg: RC!RCPackage, ordered: Sequence, started: Set){
	var f = c.`function`;
	if(not (f.isTypeOf(RC!RefExp) and f.ref.isKindOf(RC!Function))){
		return;
	}
	var fn = f.ref;
	var fp = packageOf(fn);
	if(fp.isDefined() and toolkitPackages().includes(fp.name)){
		return;
	}
	if(fp.isDefined() and fp.name = "core"){
		return;
	}
	if(started.includes(fn)){
		return;
	}
	started.add(fn);
	for(x in fn.eAllContents()){
		if(x.isKindOf(RC!CallExp)){
			addCalledFunction(x, pkg, ordered, started);
		}
	}
	if(fp <> pkg and fn.name <> "card"){
		ordered.add(fn);
	}
}

operation declareSharedVarAndConstAsLocalVar(nc: RC!NodeContainer){
	var vlset = Set<RC!VariableList>;
	vlset = Set{};
	
	//To collect vars in required interfaces, and to delare as new vars
	for(ri in nc.rinterfaces){
//		var cloned = new RC!Variable;
	
		for(vl in ri.variableList){
			vlset.add(clone(vl));
		
//			for(v in vl.vars){
//				var cloned = clone(v);//without clone, the var in Interface will be removed.
//				if(v.modifier = RC!VariableModifier#CONST){
//					cloned.modifier = RC!VariableModifier#CONST;
//				}
//				varset.add(cloned);
//			}
		}
	}
	
	var varset = new Set<RC!Variable>;
	for(varlist in vlset){
		for(v in varlist.vars){
			varset.add(v);
		}
	}
	("line 224 varset = "  + vlset).println();
	
	//to add newly delared vars into the stm.variableList, such they become local vars
//	if(nc.variableList.size()>0 and nc.variableList.select(l|l.modifier = RC!VariableModifier#VAR).size()>0){
//		nc.variableList.select(l|l.modifier = RC!VariableModifier#VAR).at(0).vars = nc.variableList.at(0).vars.includingAll(varset);
//	} else {
		
		
		if(varset.select(v|v.modifier = RC!VariableModifier#VAR).size()>0){
			var vl_var = new RC!VariableList;
			vl_var.modifier = RC!VariableModifier#VAR;
			nc.variableList.add(vl_var);
			for(v in varset.select(v|v.modifier = RC!VariableModifier#VAR)){
				vl_var.vars.add(v);
			}
		}
		
		
		//one case is not covered: when local var has the same name as the shared/requried const
		if(varset.select(v|v.modifier = RC!VariableModifier#CONST).size()>0){
			var vl_const = new RC!VariableList;
			vl_const.modifier = RC!VariableModifier#CONST;
			nc.variableList.add(vl_const);
			for(v in varset.select(v|v.modifier = RC!VariableModifier#CONST)){
				vl_const.vars.add(v);
			}
		}


//	nc.rinterfaces.clear();//this is commented out, becasue we need to know the shared vars through the rinterface so that we can declare the EXT channel
	//it makes no difference removing rinterfaces or not in terms of the update of the vars used in all the statement, because all the varrefs need to be replaced one by one in the actual stmt/expr
}


//to replace each  shared var with local var in the node container
operation Shared2FQLocalVariablesAndConst(nc: RC!NodeContainer){
	for(st in nc.nodes.select(s|s.instanceOf(RC!State))){
		for(act in st.actions){
			Shared2LocalVariablesAndConstInStmt(act.action,nc);
		}
	}
	
	for(tr in nc.transitions){
		if(tr.trigger.isDefined() and tr.trigger._type=CommunicationType#INPUT){
			//tr.trigger.type = Communication
			tr.trigger.parameter = allLocalVariablesandConst(nc).selectOne(v|v.name = tr.trigger.parameter.name // and v.modifier = RC!VariableModifier#VAR 
			);
		}
		
		if(tr.condition.isDefined()){
			Shared2LocalVariablesAndConstInExpr(tr.condition,nc);
		}
		
		if(tr.action.isDefined()){
			Shared2LocalVariablesAndConstInStmt(tr.action,nc);
		}
	}
	
	
	//here to convert all the names to FQN
	FQNllLocalVariables(nc);
}

operation FQNllLocalVariables(nc: RC!NodeContainer){

	//the name in the model is kept in ~baseName (Epsilon's side table) at the first call, so that the names can be
	//computed again for an instance of a StateMachineRef (enterInstance, leaveInstance; 25 Nov 2026). The first
	//call gives the same names as before.
	for(v in allLocalVariablesandConst(nc)){
		if(not v.~baseName.isDefined()){
			v.~baseName = v.name;
		}
		v.name = v.~baseName + "_" + nc.FQN();
	}
}

/* Instances of state machines in a controller (25 Nov 2026, decision 6 of Fang: follow .ref, no copy).
   An instance is an element of c.machines: a StateMachineDef written inside the controller, or a StateMachineRef.
   instDef: its definition; instFQN: <instance name>_<controller FQN>, the FQN of the machine as seen from the
   controller (for an inline definition the same as its FQN()). While a referenced definition is translated as
   the instance r, enterInstance sets ~inst of the definition, so that StateMachineDef.FQN() and everything built
   on it (nodes, triggers, channels) give the names of the instance, and computes the names of its local
   variables and constants again; leaveInstance undoes both. The translation of the instances is sequential, so
   two references to one definition give two sets of names. */
operation instDef(i: Any): RC!StateMachineDef{
	if(i.isKindOf(RC!StateMachineRef)){
		return i.ref;
	}
	return i;
}

operation instController(i: Any): RC!ControllerDef{
	for(c in RC!ControllerDef.all()){
		if(c.machines.includes(i)){
			return c;
		}
	}
}

operation instFQN(i: Any): String{
	return i.name + "_" + instController(i).FQN();
}

operation enterInstance(i: Any){
	if(i.isKindOf(RC!StateMachineRef)){
		var d = i.ref;
		d.~inst = i;
		FQNllLocalVariables(d);
	}
}

operation leaveInstance(i: Any){
	if(i.isKindOf(RC!StateMachineRef)){
		var d = i.ref;
		d.~inst = null;
		FQNllLocalVariables(d);
	}
}

operation Shared2LocalVariablesAndConstInStmt(
	stmt: RC!Statement,
	nc: RC!NodeContainer){
	
	if(stmt.instanceOf(RC!Assignment)){
				
		stmt.left.name = allLocalVariablesandConst(nc).selectOne(v|v.name = stmt.left.name.name); //and v.modifier = RC!VariableModifier#VAR 
		
		
		Shared2LocalVariablesAndConstInExpr(stmt.right,nc);
		
	} //else
	
	if(stmt.instanceOf(RC!Call)){
		for(arg in stmt.args){
			Shared2LocalVariablesAndConstInExpr(arg,nc);
		}
	} //else
	
	if(stmt.instanceOf(RC!IfStmt)){
		Shared2LocalVariablesAndConstInExpr(stmt.expression, nc);
		Shared2LocalVariablesAndConstInStmt(stmt.then, nc);
		Shared2LocalVariablesAndConstInStmt(stmt.`else`, nc);
		
	} //else
	
	if(stmt.instanceOf(RC!CommunicationStmt) and (stmt.communication._type=CommunicationType#SYNC or stmt.communication._type=CommunicationType#OUTPUT)){
		Shared2LocalVariablesAndConstInExpr(stmt.communication.value,nc);
	} //else
	
	if(stmt.instanceOf(RC!CommunicationStmt) and (stmt.communication._type=CommunicationType#INPUT )){
	stmt.communication.parameter = allLocalVariablesandConst(nc).selectOne(v|v.name = stmt.communication.parameter.name); //and v.modifier = RC!VariableModifier#VAR 
	
	
	} //else
	if(stmt.instanceOf(RC!SeqStatement)){
		for(s in stmt.statements){
			Shared2LocalVariablesAndConstInStmt(s, nc);
		}
	} //else
	if(stmt.instanceOf(RC!ParStmt)){
		varSet = Shared2LocalVariablesAndConstInStmt(stmt.stmt);
	} //else
	if(stmt.instanceOf(RC!TimedStatement)){
		Shared2LocalVariablesAndConstInStmt(stmt.stmt);
		Shared2LocalVariablesAndConstInStmt(stmt.deadline); //Stmt or Expr?
	} else
	{ 	}	
}


operation Shared2LocalVariablesAndConstInExpr(
	expr: RC!Expression,
	nc: RC!NodeContainer){
	
	if(expr = null){	
	} else
	
	if(expr.instanceOf(RefExp)){
		if(expr.ref.instanceOf(RC!Variable)){
			expr.ref = allLocalVariablesandConst(nc).selectOne(v|v.name = expr.ref.name);
		}
//TO DO: temporarily do not differetiate VAR and CONST
 
	} else {
	
	("line 299 expr.eContents = " +expr.eContents).println();
		for(obj in expr.eContents){
			if(obj.instanceOf(RC!Expression)){
				("obj = " + obj).println();
				Shared2LocalVariablesAndConstInExpr(obj,nc);
			}
		}
		
	}
	
}


