operation createShareAsCommunication(): Z!Communication{
	var commu = new Z!Communication;
	
	var chanExpr = new Z!RefExpr;
	var chanExpr = "share".createRefExpr(false,false);
	commu.channelExpr = chanExpr;
	commu.commPattern.name = "Synch";
	commu.commUsage.name = "Normal";
	commu.indexed = false;
	commu.multiSych = 0;
	
	return commu;
}

//TO DO: shall it be an actionPara or action?
operation createSStopActionPara(): Z!ActionPara{
	var actionPara = new Z!ActionPara;
	
	actionPara.name = "SStop".createZName();
	
	var commu = createShareAsCommunication();
	var callAction = "SStop".createCallAction();
	
	//this is a PrefixingAction
	
	actionPara.circusAction = createPrefixingAction(commu, callAction);
	
	return actionPara;
}

operation createPrefixingAction(
	commu: Z!Communication, 
	action: Z!CircusAction
	): Z!PrefixingAction{
	
	var prefixingAction = new Z!PrefixingAction;
	
	prefixingAction.communication  = commu;
	
	prefixingAction.circusAction = action;
	
	return prefixingAction;
}




operation String createAction1(type: String): Z!Action1{
	var action1 = new Z!Action1;
	
	return action1;
}

//binary circus action: not covering PrefixingAction
//TO DO: to complete other types of Action2
operation createAction2(
	type: String, 
	fst_action: Z!CircusAction, 
	snd_action: Z!CircusAction
	): Z!Action2{
	
	var action2;
	if(type = "InterruptAction"){
		//action2 = createInterruptAction(fst_action, snd_action);
		action2 = new Z!InterruptAction;
	} 
	if(type = "SeqAction"){
		action2 = new Z!SeqAction;
	} 
	if(type = "ExtChoiceAction"){
		action2 = new Z!ExtChoiceAction;
	} 	
	if(type = "InterleaveAction"){
		action2 = new Z!InterleaveAction;
	} 
	action2.leftAction = fst_action;

	action2.rightAction = snd_action;
//	action2.actionList = new Z!CircusActionList;
	
//	action2.actionList.circusActions = Sequence{action2.leftAction, action2.rightAction};
		
	return action2;
}


operation createProcess2(
	type: String, 
	fst_proc: Z!CircusProcess, 
	snd_proc: Z!CircusProcess
	): Z!Process2{
	
	var proc;
	
	if(type = "SeqProcess"){
		proc = new Z!SeqProcess;
	} 
	if(type = "ExtChoiceProcess"){
		proc = new Z!ExtChoiceProcess;
	} 	
	if(type = "InterleaveProcess"){
		proc = new Z!InterleaveProcess;
	} 
	if(type = "Process"){
		proc = new Z!InterleaveProcess;
	} 
	proc.leftProcess = fst_proc;

	proc.rightProcess = snd_proc;
//	action2.actionList = new Z!CircusActionList;
	
//	action2.actionList.circusActions = Sequence{action2.leftAction, action2.rightAction};
		
	return proc;
}

operation String createCallAction(): Z!CallAction{
	var callAction = new Z!CallAction;
	callAction.name = self.createZName();
	
	return callAction;
}



operation String createCallAction(list: Sequence<Z!Expr>): Z!CallAction{
	var callAction = new Z!CallAction;
	callAction.name = self.createZName();
	callAction.exprList =  new Z!ZExprList;
	callAction.exprList.exprs = list;
	
	return callAction;
}




operation RC!Transition createTrActionAsCircusAction(): Z!CircusAction{
	if(self.action != null){
		//return self.action.createStmtAsAction();
		return self.action.createStmtInContextAsAction();
	} else{
		return createSkipAction();
	}
}



//CSP Rule 62, this is only used in Rule 65
operation readState(varSet: Set<String>, action: Z!CircusAction):Z!CircusAction{
	if(varSet.size()=0){
		return action;
	} else {
			
		var var_name = varSet.at(0);

		var commu = createInputCommunication("get_"+var_name, var_name);
		varSet.removeAt(0);	
		var prefixAction = createPrefixingAction(commu, readState(varSet,action));
		var leftAction = "SSTOP".createCallAction();
		
		var action1 = createAction2("InterruptAction", leftAction, prefixAction);
		return action1;
	}
}


//CSP Rule 63
operation readStateAtomic(varSet: Set<String>, action: Z!CircusAction):Z!CircusAction{
	if(varSet.size()=0){
		return action;
	} else {
		
		var var_name = varSet.at(0);
		var commu = createInputCommunication("get_"+var_name, var_name);
		varSet.removeAt(0);	
		var prefixAction = createPrefixingAction(commu, readStateAtomic(varSet,action));
		
		return prefixAction;
	}
}


//CSP Rule 64
operation readStateA(varSet: Set<String>, action: Z!CircusAction):Z!CircusAction{
	if(varSet.size()=0){
		return action;
	} else {
		
		var var_name = varSet.at(0);

		var commu = createInputCommunication("get_"+var_name, var_name);
		varSet.removeAt(0);	
		var prefixAction = createPrefixingAction(commu, readStateAtomic(varSet,action));
		var leftAction = "SSTOP".createCallAction();
		
		var action1 = createAction2("InterruptAction", leftAction, prefixAction);
		return action1;
	}
}




//to create a internal input communication 
//used in readState()
operation createInputCommunication(
	chan_name: String,
	var_name:String
	): Z!Communication{
	
	var commu = new Z!Communication;

	commu.commUsage = Z!CommUsage#Normal;
	commu.indexed = false;
	commu.multiSych = 0;
	commu.channelExpr = chan_name.createRefExpr(false,false);
	
	commu.commPattern = Z!CommPattern#Input;
	commu.fieldList = new Z!CircusFieldList; 
		
	var field = new Z!InputField;
	field.varialbeName = var_name.createZName();
	commu.fieldList.fields = Sequence{field};
	
//	if(type = "INPUT"){ 
//		commu.commPattern = Z!CommPattern#Input;
//
//		var field = new Z!InputField;
//		field.varialbeName = var_name.createZName();
//		commu.fieldList.fields = Sequence{field};
//	} 
	

	
	return commu;
}


//to create a internal output communication, can be outputfield !, or dotfield .
//used in Rule 69 for output and Sync type of RoboChart Communiation
operation createOutputCommunication(
	chan_name: String,
	expr:RC!Expression,
	type: String
	): Z!Communication{
	
	var commu = new Z!Communication;

	commu.commUsage = Z!CommUsage#Normal;
	commu.indexed = false;
	commu.multiSych = 0;
	commu.channelExpr = chan_name.createRefExpr(false,false);

	commu.fieldList = new Z!CircusFieldList; 
		
	
	commu.commPattern = Z!CommPattern#Output;		
	var field = new Z!DotField;
	("line 2874 expr = " + expr).println();
	field.expr = expr.createExpr();
		
	if(type = "OUTPUT"){ 
		field.outputField = true;
	} else
	if(type = "SYNC"){ 
		field.outputField = false;
	}
	
	commu.fieldList.fields = Sequence{field};
	
	return commu;
}



//same as createOutputCommunication, but takes an already transformed Z expression
//used in Rule 66 when the value written is built from an ArrayAssignable/VarSelection
operation createOutputCommunicationFromZExpr(
	chan_name: String,
	zexpr: Z!Expr,
	type: String
	): Z!Communication{

	var commu = new Z!Communication;

	commu.commUsage = Z!CommUsage#Normal;
	commu.indexed = false;
	commu.multiSych = 0;
	commu.channelExpr = chan_name.createRefExpr(false,false);

	commu.fieldList = new Z!CircusFieldList;

	commu.commPattern = Z!CommPattern#Output;
	var field = new Z!DotField;
	field.expr = zexpr;

	if(type = "OUTPUT"){
		field.outputField = true;
	} else
	if(type = "SYNC"){
		field.outputField = false;
	}

	commu.fieldList.fields = Sequence{field};

	return commu;
}


/******************************************
Assignable Section (Rule 66 auxiliary)

RoboChart Assignable = VarRef | ArrayAssignable | VarSelection
  x = e        ->  set_x!(e)
  x[i] = e     ->  set_x!(x (+) {i |-> e})              Z: _oplus_
  x.f = e      ->  set_x!(x with field f := e)          Z: _recupd_ (custom, printed as x(|f := e|))
  x[i].f = e   ->  set_x!(x (+) {i |-> (x i) with f := e})
The update is built recursively from the innermost Assignable outwards.
***********************************************/

//The name of a record field qualified by its record type, R.f (23 Nov 2026, generator issues NN and LL). In
//Isabelle the fields of a record R are the constants R.f; with two records that have a field of the same name
//the unqualified f refers to the one declared last (checked: Point.x and Pixel.x, x p0 is a type error for
//p0 :: Point), and an unqualified f also clashes with any other constant f of the theory.
operation Any qualifiedFieldName(): String{
	var c = self.eContainer();
	if(c.isDefined() and c.isKindOf(RC!RecordType)){
		return c.name + "." + self.name;
	}
	return self.name;
}

//The variables an assignment reads through its left-hand side (23 Nov 2026, generator issue LL): none for x = e;
//for r.f = e and x[i] = e the root variable (its old value is updated) and the variables of the index
//expressions, at every level.
operation RC!Assignable leftReadVariables(container: Any): Set<String>{
	var s = new Set<String>;
	if(self.isTypeOf(RC!VarRef)){
		return s;
	}
	s.add(self.rootVarName());
	var a = self;
	while(not a.isTypeOf(RC!VarRef)){
		if(a.isTypeOf(RC!ArrayAssignable)){
			for(ix in a.parameters){
				s = s.includingAll(usedVariablesInExpr(ix, container));
			}
			a = a.value;
		} else if(a.isTypeOf(RC!VarSelection)){
			a = a.receiver;
		} else {
			return s;
		}
	}
	return s;
}

//name of the variable at the root of an Assignable, e.g. modelScore for modelScore[model]
operation RC!Assignable rootVarName(): String{
	if(self.isTypeOf(RC!VarRef)){
		return self.name.name;
	}
	if(self.isTypeOf(RC!ArrayAssignable)){
		return self.value.rootVarName();
	}
	if(self.isTypeOf(RC!VarSelection)){
		return self.receiver.rootVarName();
	}
	("rootVarName: unsupported Assignable " + self).println();
	return null;
}

//Z expression that reads the current value of an Assignable
//  VarRef x             -> x
//  ArrayAssignable a[i] -> a i        (Application, mixFix = false)
//  VarSelection r.f     -> r.f        (BindSelExpr)
operation RC!Assignable createReadExpr(): Z!Expr{
	if(self.isTypeOf(RC!VarRef)){
		return self.name.name.createRefExpr(false,false);
	}
	if(self.isTypeOf(RC!ArrayAssignable)){
		var expr = new Z!ApplExpr;
		expr.mixFix = false; //CZT: C.6.22 (Application)
		expr.leftExpr = self.value.createReadExpr();
		expr.rightExpr = self.arrayIndex().createExpr();
		return expr;
	}
	if(self.isTypeOf(RC!VarSelection)){
		var expr = new Z!BindSelExpr;
		expr.expr = self.receiver.createReadExpr();
		expr.name = self.member.qualifiedFieldName().createZName(); //qualified since 23 Nov 2026 (NN, LL)
		return expr;
	}
	("createReadExpr: unsupported Assignable " + self).println();
	return null;
}

//value of the root variable after assigning new_value to this Assignable
operation RC!Assignable createUpdatedValueExpr(new_value: Z!Expr): Z!Expr{
	if(self.isTypeOf(RC!VarRef)){
		return new_value;
	}
	if(self.isTypeOf(RC!ArrayAssignable)){
		//a (+) {i |-> new_value}; a maplet is a pair, as in createSeqExpr
		var maplet = Sequence{self.arrayIndex().createExpr(), new_value}.createTupleExpr();
		var upd = createOperatorApplExpr("_oplus_",
			Sequence{self.value.createReadExpr(), Set{maplet}.createSetExpr()});
		return self.value.createUpdatedValueExpr(upd);
	}
	if(self.isTypeOf(RC!VarSelection)){
		//the field name qualified by the record type since 23 Nov 2026 (NN, LL): r\<lparr>R.f := e\<rparr>
		var upd = createOperatorApplExpr("_recupd_",
			Sequence{self.receiver.createReadExpr(), self.member.qualifiedFieldName().createRefExpr(false,false), new_value});
		return self.receiver.createUpdatedValueExpr(upd);
	}
	("createUpdatedValueExpr: unsupported Assignable " + self).println();
	return null;
}

//the (single) index of an ArrayAssignable; sequences have exactly one index
operation RC!ArrayAssignable arrayIndex(): RC!Expression{
	if(self.parameters.size() <> 1){
		("arrayIndex: only one index is supported, found " + self.parameters.size() + " in " + self).println();
	}
	return self.parameters.first();
}

//CZT: C.6.21 (Function Operator Application) with an arbitrary operator and operands
operation createOperatorApplExpr(operator: String, operands: Sequence): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = true;
	expr.leftExpr = operator.createRefExpr(false,false);
	var exprs = new Sequence<Z!Expr>;
	for(o in operands){
		exprs.add(o);
	}
	expr.rightExpr = exprs.createTupleExpr();
	return expr;
}


//to create a internal sync communication
operation createSynchCommunication(
	channel_name:String
	): Z!Communication{
	
	var commu = new Z!Communication;
	commu.commUsage = Z!CommUsage#Normal;
	commu.indexed = false;
	commu.multiSych = 0;
	commu.channelExpr = channel_name.createRefExpr(false,false);
	commu.fieldList = new Z!CircusFieldList; 
	
	commu.commPattern = Z!CommPattern#Synch;
	commu.fieldList.fields = Sequence{};		
		
	return commu;
}




//CSP Rule 65
operation RC!Statement createStmtInContextAsAction(): Z!CircusAction{
	var action1 = self.createStmtAsAction();
	var stmt_container =  findTrStOwnerOfStmt(self);
	//Issue J: the assume fallback aviol -> P(n) only makes sense for transition actions, where P is Trans_<nc>
	//(or Transc_<nc>) and n its node parameter. For a statement of a state action (entry/during/exit) the
	//fallback named <state><nc FQN>, a constant that does not exist, applied to a free n. For now such
	//statements get no assume wrapper; statements on transitions keep "assume True" as a placeholder.
	if(usedVariables(self).size()=0 or not isOwnedByTransition(self)){
		return readState(usedVariables(self), action1);
	} else
	//an extra step introduced to change action1 into "if inv_on_usedVariables(self) then action else aviol -> action"
	//to introduce assumption condition, i.e. to change action into if inv then action else aviol -> action
	//by creating an IfGuardedCommand 
	//true means inv=true, this true shall be MANUALLY REPLACED by invariant on the variables whose values are read
	{
		var if_pred = createTruePred();
		
		//if true then continue to behave as action itself
		var ifAction = createGuardedAction(if_pred, action1) ;
		
		var else_pred = createFalsePred();
		
//		//if false then aviol -> action
//		var action2 = self.createStmtAsAction();
//		var elseAction = createPrefixingAction(createSynchCommunication("aviol"), action2);
//		elseAction = createGuardedAction(else_pred, elseAction);
		
		
		
		/*elseif false then aviol -> Trans(n)
		this only works for assume-gurantee in Transitions, as we fall back to Trans(n)
		if fall back to other process Q, aviol -> Q can not be discharged in ddlf proof
		*/
		
		//the following commented out content need to be fixed later, we need to find the node container of the stmt, 
		//but for some stmt, errors
//		var fqn = nc(self);
//		("fqn = " + fqn).println();
//		("self stmt = " +self).println;
//		
//		("self stmt left= " +self.left.name).println;

		/*
		 * this is a workaround for name the process that contains this stmt
		 * It is not necessarily Trans, can also be State_xx
		 * Currently, need correct it by hand after the auto-gen
		 * To be fixed in future 05Dec2025
		*/
//		var id = "tbd";
//		var elseAction = createPrefixingAction(createSynchCommunication("aviol"), ("Trans_" + id).createCallAction(Sequence{"n"}.createRefExprSeq(false,false)));
		var elseAction = createPrefixingAction(createSynchCommunication("aviol"), stmt_container.createCallAction(Sequence{"n__id"}.createRefExprSeq(false,false)));
		elseAction = createGuardedAction(else_pred, elseAction);
	
	
	
	
		var actions = Sequence{ifAction, elseAction};
		
		var ifguard_action = createIFGuardedCommand(actions);
		
	//	return readState(usedVariables(self), action);// we replace action with ifguard_action to introduce assumption for read vars 
		return readState(usedVariables(self), ifguard_action);
	
	}
}

//CSP Rule 65_aux
operation RC!Statement createStmtAsAction(): Z!CircusAction{
	//withToolkitGuards (16 Nov 2026, generator issue AA): the preconditions of toolkit functions, for the four
	//kinds of statements that the CSP-M generator guards (assignment, call, communication, if)
	if(self.instanceOf(RC!Assignment)){
		return self.withToolkitGuards(self.createAssignmentStmtAsAction());
	} else
	if(self.instanceOf(RC!Call)){
		return self.withToolkitGuards(self.createCallStmtAsAction());
	} else
	if(self.instanceOf(RC!Skip)){
		return self.createSkipStmtAsAction();
	} else
	if(self.instanceOf(RC!CommunicationStmt)){
		return self.withToolkitGuards(self.createCommuStmtAsAction());
	} else
	if(self.instanceOf(RC!ParStmt)){
		return self.createParStmtAsAction();
	} else
	if(self.instanceOf(RC!IfStmt)){
		return self.withToolkitGuards(self.createIfStmtAsAction());
	} else
	if(self.instanceOf(RC!SeqStatement)){
		return self.createSeqStmtAsAction();
	} else
	{}
}




//CSP Rule 66
operation RC!Assignment createAssignmentStmtAsAction(): Z!CircusAction{
	
	/*/
	//assignment is an interrupt action in Circus
	//left action is SStop
	//right action is a prefixing action
	/*/
	
	/* CallAction permits a name to be an action.	*/
	var leftAction = "SSTOP".createCallAction();

	//the channel is always set_x for the root variable x, even if the left side is x[i] or x.f;
	//for x[i] = e the value written is x (+) {i |-> e}, for x.f = e it is x with field f updated
	var chan_name = "set_" + self.left.rootVarName();
	var new_value = self.left.createUpdatedValueExpr(self.right.createExpr());

	var prefix = createOutputCommunicationFromZExpr(chan_name, new_value, "OUTPUT");

	var rightAction = createPrefixingAction(prefix, createSkipAction());
	//PrefixingAction is a type of Action1, so can not use createAction2()


	/*to introduce guarantee condition for writing var values, i.e. to change rightAction from
	 "set_vid(s.left)![[s.right]]expr -> Skip" 
	 TO 
	 "if inv then (set_vid(s.left)![[s.right]]expr -> Skip) else gviol -> STOP
	 by creating an IfGuardedCommand (similar to the changes of Rule 53)*/
		
	//true means inv=true, it is a default inv, and shall be MANUALLY REPLACED by actual invariant on the variables in HOL-CSP models
	var if_pred = createTruePred();
	
	//if true then continue to behave as rightAction, i.e., write the value
	var ifAction = createGuardedAction(if_pred, rightAction) ;
	
	var else_pred = createFalsePred();
	
	//elseif false then gviol -> STOP
	var elseAction = createPrefixingAction(createSynchCommunication("gviol"), createStopAction());
	elseAction = createGuardedAction(else_pred, elseAction);
	
	var actions = Sequence{ifAction, elseAction};
	
	
	var right_action = createIFGuardedCommand(actions);
	
	
	var circusAction = createAction2("InterruptAction", leftAction, right_action);
	
	

	//if assignment.right is a call of a USER-DEFINED function with preconditions, circusAction is guarded by
	//the conjunction of its preconditions with the arguments of the call in place of the formal parameters,
	//e.g. x = location(gs) with precondition size(gs) > 0 gives (size(gs) > 0) & (SSTOP /\ set_x!location(gs) -> Skip);
	//the CSP-M writes pre_Chemical_location(gs) & ... (userPreconditionGuard below).
	//Fix of generator issue CC (22 Nov 2026, branch composite-states). Before, the precondition was copied with the
	//FORMAL parameters (x = head(q) got the guard of head with the formal of head) and toolkit functions got a
	//second guard besides the one of AA (toolkitGuards). Now: toolkit functions are skipped (AA guards them), the
	//formals are replaced by the arguments (by position, each argument in parentheses), and a bound name of the
	//precondition (quantifier, lambda, set comprehension, let) that occurs in an argument is renamed first.
	//PROVISIONAL: the preconditions are guards as in RoboTool's CSP-M. In January 2026 Ana and Alvaro concluded that
	//the right semantics is that of the manual, which does not treat a precondition as a guard; the guards of the
	//CSP-M are a pragmatic choice. The ITP 2026 paper uses the semantics with guards. When preconditions become
	//definedness proof obligations, this guard is removed (with the guards of AA, in the same change).
	//Only for an assignment whose right-hand side is the call itself (as before the fix); AA covers four kinds of
	//statement and descends into divisions, sequence indexing and arguments (docs/SEMANTICS_DIFFERENCES.md, entry 7).
	if(self.right.isKindOf(RC!CallExp)){
		var g = self.right.userPreconditionGuard();
		if(g.isDefined()){
			circusAction = createGuardedAction(g.createMemPredEquality(), circusAction);
		}
	}

	return circusAction;
}

//Generator issue CC (22 Nov 2026): the guard of a call of a user-defined function with preconditions, or null.
//null for a call of a toolkit function (guarded by AA, toolkitGuardsOf), of a function-typed variable or constant
//(no preconditions) and of a function without preconditions. Several preconditions are joined by conjunction.
operation RC!CallExp userPreconditionGuard(): Any{
	var f = self.`function`;
	if(not (f.isTypeOf(RC!RefExp) and f.ref.isKindOf(RC!Function))){
		return null;
	}
	var pkg = packageOf(f.ref);
	if(pkg.isDefined() and toolkitPackages().includes(pkg.name)){
		return null;
	}
	var pres = f.ref.preconditions;
	if(pres.size() = 0){
		return null;
	}
	var precond = null;
	for(p in pres){
		var e = self.substitutedPrecondition(p).createExpr();
		if(e.isUndefined()){
			//createExpr has no case for the expression (e.g. exists, forall, lambda, set comprehension: not translated
			//anywhere by this generator); the marker as the guard, so that Isabelle stops here instead of the guard
			//being lost (22 Nov 2026; before the fix of CC such a guard was not checked)
			("Precondition of " + f.ref.name + " not translated (expression not supported, e.g. a quantifier); "
				+ "printed as the guard marker").println();
			return generatorErrorMarker("untranslated_precondition", f.ref.name).createRefExpr(false,false);
		}
		if(precond.isUndefined()){
			precond = e;
		} else {
			precond = createAndExpr(precond, e);
		}
	}
	return precond;
}

//Generator issue CC (22 Nov 2026): a copy of the precondition pre of the function called by self with the arguments
//of the call in place of the formal parameters (by position; a copy of each argument, printed in parentheses). Bound names of
//the copy that occur in an argument are renamed first (name_1, name_2, ...; fresh with respect to the names of the
//arguments and of the precondition), so that no name of an argument is captured. The copy keeps its references to
//its own bound variables (EcoreUtil.copy), so renaming a bound variable renames its occurrences.
operation RC!CallExp substitutedPrecondition(pre: RC!Expression): RC!Expression{
	var fn = self.`function`.ref;
	var copy = clone(pre);
	var argNames = new Set;
	for(a in self.args){
		for(x in Sequence{a}.includingAll(allContentsOf(a))){
			if(x.isKindOf(RC!RefExp)){ argNames.add(x.ref.name); }
		}
	}
	var copyNodes = Sequence{copy}.includingAll(allContentsOf(copy));
	var used = new Set;
	used.addAll(argNames);
	for(x in copyNodes){
		if(x.isKindOf(RC!RefExp)){ used.add(x.ref.name); }
		if(x.isKindOf(RC!Variable) or x.isKindOf(RC!Declaration)){ used.add(x.name); }
	}
	for(x in copyNodes){
		if((x.isKindOf(RC!Variable) or x.isKindOf(RC!Declaration)) and argNames.includes(x.name)){
			var k = 1;
			while(used.includes(x.name + "_" + k)){ k++; }
			("CC: bound name " + x.name + " of a precondition of " + fn.name + " renamed to " + x.name + "_" + k
				+ " (it occurs in an argument)").println();
			x.name = x.name + "_" + k;
			used.add(x.name);
		}
	}
	var emfTool = new Native("org.eclipse.epsilon.emc.emf.tools.EmfTool");
	var ecoreUtil = emfTool.ecoreUtil;
	for(x in copyNodes){
		if(x.isKindOf(RC!RefExp) and fn.parameters.includes(x.ref)){
			//a copy of the argument, not a new RC!ParExp: a new object would be added to the RoboChart model as a
			//root. The parentheses come from the printers, which print every binary operation, call and
			//indexing in parentheses or as an atom (createExpr drops a ParExp anyway).
			var arg = clone(self.args.at(fn.parameters.indexOf(x.ref)));
			if(x = copy){
				copy = arg;
			} else {
				ecoreUtil.replace(x, arg);
			}
		}
	}
	return copy;
}

//all objects contained in o, at any depth (eContents recursively)
operation allContentsOf(o: Any): Sequence{
	var r = new Sequence;
	for(c in o.eContents()){
		r.add(c);
		r.addAll(allContentsOf(c));
	}
	return r;
}

operation createStopAction(): Z!StopAction{
	var a = new Z!StopAction;
	return a;
}

operation createAndExpr(
	l:Z!Expr,
	r:Z!Expr): Z!ApplExpr{
	
	var expr = new Z!ApplExpr;
	
	expr.mixFix = true; //CZT: C.6.21 (Function Operator Application). For example: S + T.
	
	expr.leftExpr = "_And_".createRefExpr(false,false);

	expr.rightExpr = Sequence{l, r}.createTupleExpr();	
	
	return 	expr;
}

//CSP Rule 67
operation RC!Call createCallStmtAsAction(): Z!CircusAction{
	
	var list = new Sequence<Z!Expr>;
	
	for(elem in self.args){
		list.add(elem.createExpr());
	}
//	var circusAction = self.`operation`.name.createCallAction(list);
	var circusAction = ("CALL__" + self.`operation`.name).createCallAction(list);
	return circusAction;
}



//CSP Rule 68
operation RC!IfStmt createIfStmtAsAction(): Z!IfGuardedCommand{
	
	var if_expr = self.expression;
		"line999".println();
	self.expression.println();
//		var ifAction = createGuardedAction(pred_expr, self.then.createStmtAsAction());
	var if_pred = self.expression.createExpr().createMemPredEquality();
	
	var ifActionInContext = createGuardedAction(if_pred, self.then.createStmtInContextAsAction());
	
	var actions;
	
//	RoboChart allow else to be not defined
//	e.g.,transition t1 {
//		  from s0
//		  to s1
//	      action if true then a end, or
//	      action if true then a else b end, or
//        action if true then a else if bl then b else c end end 
//        action if true then a else (if bl then b else c end) end }
	if(self.`else`.isDefined()){
		var else_expr = new RC!Not;
		else_expr.exp = clone(if_expr);
		//else_pred.exp = self.expression;
	
		var pred_else = else_expr.createExpr().createMemPredEquality();
		
		var elseActionInContext = createGuardedAction(pred_else, self.`else`.createStmtInContextAsAction());
		
		actions = Sequence{ifActionInContext, elseActionInContext};
	} else {
		//Generator issue FF, second part (22 Nov 2026, branch composite-states; present since the rules of the ITP
		//2026 paper). Without else the command had one branch and was printed "if b then P" without else, which
		//Isabelle does not parse (transition actions as well as state actions). As RoboTool's CSP-M
		//(CStatementGenerator.xtend 274, "else SKIP") and the meaning of "if e then s end" in RoboChart: the
		//missing else is Skip. Same construction of the negated condition as for an else above.
		var no_else_expr = new RC!Not;
		no_else_expr.exp = clone(if_expr);
		var pred_no_else = no_else_expr.createExpr().createMemPredEquality();
		var skipActionInContext = createGuardedAction(pred_no_else, createSkipAction());
		actions = Sequence{ifActionInContext, skipActionInContext};
	}
	
	var action = createIFGuardedCommand(actions);
	
	return action;
}


operation createIFGuardedCommand(actions: Sequence<Z!GuardedAction>): Z!IfGuardedCommand{
	var action = new Z!IfGuardedCommand;
//	action.actionList = new Z!CircusActionList;
//	action.actionList.circusActions = actions;
	action.circusActions = actions;
	return action;
}


operation clone(exp : RC!Expression) : RC!Expression   {
	var emfTool = new Native("org.eclipse.epsilon.emc.emf.tools.EmfTool");
	var ecoreUtil = emfTool.ecoreUtil;
	var cloned = ecoreUtil.copy(exp);
	return cloned;
}




/*
operation if_pred(actions: Sequence<Z!GuardedAction>): Z!IfGuardedCommand{
	var action = new Z!IfGuardedCommand;
	action.actionList = new Z!CircusActionList;
	action.actionList.circusActions = actions;
	
	return action;
}
*/
operation createGuardedAction(
	pred: Z!Pred, 
	action: Z!CircusAction
	): Z!GuardedAction{
	var guardedaction = new Z!GuardedAction;
	
	guardedaction.pred = pred;
	guardedaction.circusAction = action;
	return guardedaction;
}





