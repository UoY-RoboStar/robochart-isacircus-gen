//CZT: C.6.21 (Function Operator Application). For example: S + T.
operation Any createApplExpr(operator: String): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = true; //CZT: C.6.21 (Function Operator Application). For example: S + T.
	
	("line 6816, self.left = " + self.left).println();
	("line 6816, self.right = " + self.right).println();
	var operand_left = self.left.createExpr();
	"line 6819".println();
	var operand_right = self.right.createExpr();
	("line 6820, operand_left = " + operand_left).println();
	("line 6820, operand_right = " + operand_right).println();
	expr.leftExpr = operator.createRefExpr(false,false);

	expr.rightExpr = Sequence{operand_left, operand_right}.createTupleExpr();	
//	var left = operator.createRefExpr(false,false);
//	var right = Sequence{operand_left, operand_right}.createTupleExpr();	

//	expr.exprList = new Z!ZExprList;
//	expr.exprList.exprs = Sequence{left, right};
	
	return 	expr;
}



//CZT: C.6.22 (Application)
//RC CallExp is a Z ApplExpr
operation RC!CallExp createCallExpr(): Z!ApplExpr{
	var expr = new Z!ApplExpr;
	expr.mixFix = false; 
	"line 6842 executed".println();
	("line 6843, self = " + self).println();
	("line 6843, self.`function`.type() = " + self.`function`.type()).println();
	("line 6843, self.`function`.ref = " + self.`function`.ref).println();
	("line 6843, self.`function`.ref.name = " + self.`function`.ref.name).println();
	
	expr.leftExpr = self.`function`.createExpr();
	//A function of a toolkit (16 Nov 2026, generator issue AA): written with the qualified name
	//<package>_<function>, as RoboTool's CSP-M generator does (ExpressionGenerator.xtend, compileCallExpression,
	//https://github.com/UoY-RoboStar/robochart-csp-gen/blob/a6412b40c83ded4ab2c18c2b9bd28575ec270983/circus.robocalc.robochart.generator.csp/src/circus/robocalc/robochart/generator/csp/untimed/ExpressionGenerator.xtend#L190-L237);
	//the templates print it by toolkitFunctionTable (toolkitFunctions.eol). A toolkit function that is not
	//in the table, and size of a set, stop the generation.
	var tkName = toolkitCallName(self);
	if(tkName.isDefined()){
		expr.leftExpr = tkName.createRefExpr(false,false);
	}
	
	("self.function = " + self.`function`).println();
	("self.function.type = " + self.`function`.type()).println();
	
	("self.function.asString() = " + self.`function`.asString()).println();
	"line 6849 executed".println();
	var arg_seq = new Sequence<Z!Expr>;
	for(arg in self.args){
		arg_seq.add(arg.createExpr());
	}
	expr.rightExpr = arg_seq.createTupleExpr();	
//	var left = operator.createRefExpr(false,false);
//	var right = Sequence{operand_left, operand_right}.createTupleExpr();	

//	expr.exprList = new Z!ZExprList;
//	expr.exprList.exprs = Sequence{left, right};
	"line 6860 executed".println();
	return 	expr;
}


//Generator convention, not a rule of the manual (16 Nov 2026, generator issue AA). The qualified name
//<package>_<function> of a call of a toolkit function, or null for another call. For a toolkit function that
//is not supported (not in toolkitFunctionTable) and for size of a set, the marker of generatorErrors.eol
//(GENERATOR_ERROR_unsupported_toolkit_<package>_<function>, GENERATOR_ERROR_size_of_set) in place of the
//name, printed as a call; Isabelle stops there (16 Nov 2026, branch m2t-partial-output; before, these cases
//stopped the generation).
operation toolkitCallName(c: RC!CallExp): Any{
	var f = c.`function`;
	if(not (f.isTypeOf(RC!RefExp) and f.ref.isKindOf(RC!Function))){
		return null;
	}
	var pkg = packageOf(f.ref);
	if(pkg.isUndefined() or not toolkitPackages().includes(pkg.name)){
		return null;
	}
	var name = pkg.name + "_" + f.ref.name;
	if(not toolkitFunctionTable().containsKey(name)){
		("Toolkit function " + f.ref.name + " (package " + pkg.name + ") is not supported by the HOL-CSP "
			+ "generator yet (generator issue AA; see toolkitFunctions.eol); printed as a marker.").println();
		return generatorErrorMarker("unsupported_toolkit", name);
	}
	if(name = "sequence_toolkit_size"){
		var t = c.args.first().rcType();
		if(t.isDefined() and t.isKindOf(RC!SetType) and not t.isKindOf(RC!SeqType)){
			("Toolkit function size applied to a set is not supported by the HOL-CSP generator yet "
				+ "(generator issue AA: the Isabelle term would be card); printed as a marker.").println();
			return generatorErrorMarker("size_of_set", "");
		}
	}
	return name;
}

//Preconditions of toolkit functions as guards (16 Nov 2026, generator issue AA). As RoboTool's CSP-M
//generator (CStatementGenerator.xtend, guards(Statement), guards(Expression) and guard, lines 447-562 of
//https://github.com/UoY-RoboStar/robochart-csp-gen/blob/a6412b40c83ded4ab2c18c2b9bd28575ec270983/circus.robocalc.robochart.generator.csp/src/circus/robocalc/robochart/generator/csp/comp/untimed/CStatementGenerator.xtend#L447-L562):
//an assignment, a communication statement, an operation call and an if statement are guarded by
//pre_<function>(args) for every call of a function with a precondition that the guards of the CSP-M
//generator reach: the expressions of the statement (for a communication its value, for an if its condition,
//for an assignment also the index of an indexed left-hand side), descending only through divisions, sequence
//indexing and the arguments of calls, as there. The guard is placed after the reads of the statement and
//before it, as there (readState(vars, guard & stmt)); several guards are nested in the reverse order, as the
//CSP-M writes g1 & g2 & ... & stmt. Only toolkit functions; DIFFERENT FROM CSP-M: the guards of the CSP-M
//for division by zero and for an index outside the sequence are not generated here; the preconditions of
//user-defined functions only for x = f(args) (createAssignmentStmtAsAction, generator issue CC, fixed 22 Nov
//2026). Transition conditions are not guarded, in the CSP-M neither. PROVISIONAL (22 Nov 2026): see CC.
operation RC!Statement toolkitGuards(): Sequence{
	var conds = new Sequence;
	if(self.isKindOf(RC!CommunicationStmt)){
		if(self.communication.value.isDefined()){
			conds.addAll(toolkitGuardsOf(self.communication.value));
		}
	} else if(self.isKindOf(RC!IfStmt)){
		conds.addAll(toolkitGuardsOf(self.expression));
	} else {
		for(e in self.eContents().select(x|x.isKindOf(RC!Expression))){
			conds.addAll(toolkitGuardsOf(e));
		}
		if(self.isKindOf(RC!Assignment) and self.left.isKindOf(RC!ArrayAssignable)
			and self.left.parameters.size() = 1){
			conds.addAll(toolkitGuardsOf(self.left.parameters.first()));
		}
	}
	return conds;
}

//guards(Expression) of the CSP-M generator, keeping only the preconditions of toolkit functions
operation toolkitGuardsOf(o: Any): Sequence{
	var conds = new Sequence;
	if(o.isKindOf(RC!Div)){
		conds.addAll(toolkitGuardsOf(o.left));
		conds.addAll(toolkitGuardsOf(o.right));
	} else if(o.isKindOf(RC!ArrayExp)){
		var t = o.value.rcType();
		if(t.isDefined() and t.isKindOf(RC!SeqType) and o.parameters.size() = 1){
			conds.addAll(toolkitGuardsOf(o.value));
			conds.addAll(toolkitGuardsOf(o.parameters.first()));
		}
	} else if(o.isKindOf(RC!CallExp)){
		var name = toolkitCallName(o);
		//a marker (unsupported function, size of a set) has no guard of its own: the call is the marker
		if(name.isDefined() and not name.startsWith("GENERATOR_ERROR_")
			and o.`function`.ref.preconditions.size() > 0){
			var pre = "pre_" + name;
			if(not toolkitFunctionTable().containsKey(pre)){
				//no pre_ entry in the table: the marker as the guard (16 Nov 2026; before, an exception)
				pre = generatorErrorMarker("no_precondition_guard", name);
			}
			if(pre.startsWith("GENERATOR_ERROR_") or toolkitFunctionTable().get(pre) <> ""){
				var g = new Z!ApplExpr;
				g.mixFix = false;
				g.leftExpr = pre.createRefExpr(false,false);
				var args = new Sequence<Z!Expr>;
				for(a in o.args){ args.add(a.createExpr()); }
				g.rightExpr = args.createTupleExpr();
				conds.add(g);
			}
		}
		for(e in o.args){
			conds.addAll(toolkitGuardsOf(e));
		}
	}
	return conds;
}

//the action of a statement under its guards (toolkitGuards), nested in the reverse order
operation RC!Statement withToolkitGuards(action: Z!CircusAction): Z!CircusAction{
	var a = action;
	for(g in self.toolkitGuards()){
		a = createGuardedAction(g.createMemPredEquality(), a);
	}
	return a;
}

//covers Neg, Not
//TO DO: is there other unaryApplExpr?
operation Any createUnaryApplExpr(operator: String): Z!ApplExpr{

	var expr = new Z!ApplExpr;
	expr.mixFix = true;
	
	expr.leftExpr = operator.createRefExpr(false,false);
	
	if(self.isTypeOf(Neg) or self.isTypeOf(Not)){
		expr.rightExpr = self.exp.createExpr();
	} 
		
//	expr.exprList = new Z!ZExprList;
//	expr.exprList.exprs = Sequence{expr.leftExpr, expr.rightExpr};

	return 	expr;
}

operation RC!LessThan createLessThanExpr():Z!ApplExpr{
	return self.createApplExpr("_less_");
}


